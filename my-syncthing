def install_completion() -> None:
    """Best effort, every run: ~/.zsh/completions/_my-syncthing, and the fpath line once."""
    if os.getuid() == 0 or OUT.simulate:
        return
    try:
        d = os.path.expanduser("~/.zsh/completions")
        path = os.path.join(d, f"_{NAME}")
        try:
            with open(path) as fh:
                if fh.read() == COMPLETION:
                    return
        except FileNotFoundError:
            pass
        os.makedirs(d, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp.")
        with os.fdopen(fd, "w") as fh:
            fh.write(COMPLETION)
        os.chmod(tmp, 0o644)                 # 600 would make compinit skip it silently
        os.replace(tmp, path)
        home = os.path.expanduser("~")
        for n in os.listdir(home):
            if n.startswith(".zcompdump"):
                os.remove(os.path.join(home, n))
        rc = os.path.join(home, ".zshrc")
        line = "fpath=(~/.zsh/completions $fpath)"
        text = ""
        if os.path.exists(rc):
            with open(rc) as fh:
                text = fh.read()
        if line in text:
            return
        lines = text.splitlines(keepends=True)
        at = next((i for i, x in enumerate(lines) if "oh-my-zsh.sh" in x and x.lstrip().startswith(("source", "."))),
                  None)
        if at is None:
            lines.append(f"\n{line}\nautoload -Uz compinit && compinit\n")
        else:
            lines.insert(at, line + "\n")
        with open(rc + ".tmp", "w") as fh:
            fh.write("".join(lines))
        os.replace(rc + ".tmp", rc)
    except OSError as e:
        dbg(f"zsh completion not installed: {e}")


