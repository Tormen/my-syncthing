def t_firewall(t: T) -> None:
    t.conf(HUB_ADDRESSES="tcp://hub.example.org:18229 tcp://192.0.2.1:22000 quic://hub.example.org:18229")
    cfg = read_config(t.p("conf"))
    rules, left = firewall_rules(cfg, "hubx", "/x/syncthing")
    t.is_("the hub: any incoming connection to its syncthing, nothing outgoing", (rules, left),
          ([["allow", "/x/syncthing", "any", "--incoming", "--port", "any", "--owner", "anyone"]], list[str]()))
    rules, left = firewall_rules(cfg, t.host, "/x/syncthing")
    t.is_("a peer: outgoing to the hub's name and port, nothing incoming",
          rules, [["allow", "/x/syncthing", "hub.example.org", "--host", "--port", "18229", "--owner", "anyone"]])
    t.is_("...an IP and a quic address named as not covered", left,
          ["tcp://192.0.2.1:22000", "quic://hub.example.org:18229"])
    t.conf(HUB_ADDRESSES="tcp://hub.example.org:18229", SYNC_USER="someone")
    by_user = read_config(t.p("conf"))
    owners = [r[-2:] for h in ("hubx", t.host) for r in firewall_rules(by_user, h, "/x/syncthing")[0]]
    t.is_("with SYNC_USER: owned by who runs Syncthing, as Little Snitch's alert writes it",
          owners, [["--owner", "someone"], ["--owner", "someone"]])
    calls = t.p("snitch.calls")
    with open(t.p("bin", FIREWALL), "w") as fh:
        fh.write(f"#!/bin/dash\nprintf '%s\\n' \"$*\" >> {shlex.quote(calls)}\necho ' >>> added: x' >&2\n")
    os.chmod(t.p("bin", FIREWALL), 0o755)
    old_path, old_app = os.environ.get("PATH", ""), _little_snitch_app

    def go(path: str, app: str, simulate: bool = False) -> str:
        global _little_snitch_app
        got = io.StringIO()
        os.environ["PATH"], _little_snitch_app, OUT.simulate = path, app, simulate
        try:
            with contextlib.redirect_stdout(got):
                ensure_firewall(cfg, "hubx", "/x/syncthing")
        finally:
            os.environ["PATH"], _little_snitch_app, OUT.simulate = old_path, old_app, False
        return got.getvalue()

    o = go("/usr/bin:/bin", t.p("bin"))
    t.is_("no my-little-snitch: skipped, in one line", (o.strip(), os.path.exists(calls)),
          (f"> Little Snitch rules: skipped -- no {FIREWALL} on PATH", False))
    o = go(t.p("bin"), t.p("no-such.app"))
    t.is_("no Little Snitch: skipped, in one line", (o.strip(), os.path.exists(calls)),
          ("> Little Snitch rules: skipped -- Little Snitch is not installed", False))
    o = go(t.p("bin"), t.p("bin"), simulate=True)
    t.is_("-S: shown, without go", open(calls).read().splitlines(),
          ["allow /x/syncthing any --incoming --port any --owner anyone"])
    o = go(t.p("bin"), t.p("bin"))
    t.is_("...and added with go", open(calls).read().splitlines()[-1],
          "allow go /x/syncthing any --incoming --port any --owner anyone")
    t.has("...what it said, passed on", o, ">>> added: x")


