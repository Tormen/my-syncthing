LABEL: Final = f"{NAME}.syncthing"
CHECK_LABEL: Final = f"{NAME}.check"


def syncthing_bin() -> str:
    return shutil.which("syncthing") or ""


def write_file(path: str, data: bytes, why: str) -> bool:
    """Write only when it differs; temp file + rename. True when it changed."""
    try:
        with open(path, "rb") as fh:
            if fh.read() == data:
                return False
    except FileNotFoundError:
        pass
    out(f"    > {path} ({why})")
    if OUT.simulate:
        return True
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp.")
    with os.fdopen(fd, "wb") as fh:
        fh.write(data)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    return True


def serve_args(cfg: Config, binary: str) -> list[str]:
    # --log-file=default: Syncthing's own syncthing.log, rotated by Syncthing; a
    # launchd service's stdout goes nowhere
    return [binary, "serve", "--no-browser", "--no-restart", "--log-file=default"] + (
        [f"--home={os.path.expanduser(cfg.syncthing_home)}"] if cfg.syncthing_home else [])


def launchd_load(domain: str, label: str, path: str, changed: bool) -> None:
    loaded = run(["launchctl", "print", f"{domain}/{label}"]).returncode == 0
    if loaded and not changed:
        return
    if loaded:
        run(["launchctl", "bootout", f"{domain}/{label}"], "reload: its file changed", changes=True)
        # launchd lets go of it a moment AFTER bootout returns; a bootstrap
        # before that fails with rc 5 and leaves the service unloaded
        end = time.time() + 15
        while not OUT.simulate and time.time() < end and \
                run(["launchctl", "print", f"{domain}/{label}"]).returncode == 0:
            time.sleep(0.5)
    p = run(["launchctl", "bootstrap", domain, path], "start it", changes=True)
    if p.returncode != 0:
        err("00042", f"launchctl bootstrap {domain} {path} failed [rc {p.returncode}]: {p.stderr.strip()}")


def plist(label: str, argv: list[str], extra: JObj) -> bytes:
    d: JObj = {"Label": label, "ProgramArguments": argv,
               "EnvironmentVariables": {"PATH": os.environ.get("PATH", "/usr/bin:/bin")}}
    d.update(extra)
    return plistlib.dumps(d)


FIREWALL: Final = "my-little-snitch"       # Little Snitch's rules from the command line -- optional
_little_snitch_app = "/Applications/Little Snitch.app"


def firewall_rules(cfg: Config, host: str, binary: str) -> tuple[list[list[str]], list[str]]:
    """The Little Snitch rules this host's Syncthing needs, as FIREWALL's arguments, and the
    hub addresses they leave uncovered. The hub: any incoming connection -- the peers come in
    from anywhere, and Syncthing itself admits only the devices of its config. A peer: outgoing
    to each hub address given as tcp://<name>:<port> (FIREWALL writes host names, not IPs).
    Owned by SYNC_USER, who runs Syncthing, as Little Snitch's own alert writes it -- else anyone."""
    owner = ["--owner", cfg.sync_user or "anyone"]
    if host == cfg.hub:
        return [["allow", binary, "any", "--incoming", "--port", "any", *owner]], []
    rules: list[list[str]] = []
    left: list[str] = []
    for a in cfg.hub_addresses:
        m = re.fullmatch(r"tcp[46]?://([^/:\[\]]+):(\d+)", a)
        if m is None or re.fullmatch(r"[\d.]+", m.group(1)):
            left.append(a)
        else:
            rules.append(["allow", binary, m.group(1), "--host", "--port", m.group(2), *owner])
    return rules, left


def ensure_firewall(cfg: Config, host: str, binary: str) -> None:
    """As root, before the service starts: firewall_rules through FIREWALL, so Little Snitch
    asks nobody -- skipped, in one line, where either is not installed. -S shows them."""
    PHASE[0] = "the Little Snitch rules"
    tool = shutil.which(FIREWALL)
    if not os.path.isdir(_little_snitch_app) or not tool:
        out(f"    > Little Snitch rules: skipped -- "
            + ("Little Snitch is not installed" if not os.path.isdir(_little_snitch_app) else f"no {FIREWALL} on PATH"))
        return
    rules, left = firewall_rules(cfg, host, binary)
    for r in rules:
        p = run([tool, r[0], *([] if OUT.simulate else ["go"]), *r[1:]], "a Little Snitch rule")
        for line in (p.stdout + p.stderr).splitlines():
            out(f"    {line}")
        if p.returncode != 0:
            sys.stderr.write(f"WARNING: the Little Snitch rule was not written [rc {p.returncode}] -- "
                             f"Little Snitch will ask at the first connection\n")
    for a in left:
        out(f"    > Little Snitch: no rule for {a} -- {FIREWALL} writes host names over tcp")


def install_root(cfg: Config) -> int:
    """As root, what needs root: the Little Snitch rules, then the boot-time service of
    SERVICE=daemon, run as SYNC_USER."""
    host = this_host()
    kind = cfg.service_of(host)
    binary = syncthing_bin()
    if not binary:
        err("00046", f"no syncthing on PATH -- run `{NAME} --install` as {cfg.sync_user or 'the user'} "
            f"first (it installs it)")
    out(f" >>> {host} ({'hub' if host == cfg.hub else 'peer'}; SERVICE={kind}) as root")
    ensure_firewall(cfg, host, binary)
    if kind != "daemon":
        out(f" >>> done -- nothing else needs root here; now `{NAME} --install` as "
            f"{cfg.sync_user or 'the user'}")
        return 0
    if not cfg.sync_user:
        err("00044", "SYNC_USER is empty -- a daemon needs to know whose Syncthing it runs")
    import pwd
    try:
        pw = pwd.getpwnam(cfg.sync_user)
    except KeyError:
        err("00045", f"SYNC_USER='{cfg.sync_user}': no such user on {host}")
    PHASE[0] = "installing the boot-time service"
    out(f" >>> {host}: Syncthing from boot, as {cfg.sync_user} (SERVICE=daemon)")
    if ON_MAC:
        path = f"/Library/LaunchDaemons/{LABEL}.plist"
        data = plist(LABEL, serve_args(cfg, binary), {
            "UserName": cfg.sync_user, "RunAtLoad": True, "KeepAlive": True, "ProcessType": "Background",
            "EnvironmentVariables": {"HOME": pw.pw_dir, "PATH": os.environ.get("PATH", "/usr/bin:/bin")}})
        changed = write_file(path, data, "the daemon, run as " + cfg.sync_user)
        if changed and not OUT.simulate:
            os.chown(path, 0, 0)
        launchd_load("system", LABEL, path, changed)
    else:
        unit = f"syncthing@{cfg.sync_user}.service"
        if run(["systemctl", "is-enabled", unit]).stdout.strip() != "enabled" or \
                run(["systemctl", "is-active", unit]).stdout.strip() != "active":
            p = run(["systemctl", "enable", "--now", unit], "the daemon, run as " + cfg.sync_user, changes=True)
            if p.returncode != 0:
                err("00047", f"systemctl enable --now {unit} failed [rc {p.returncode}]: {p.stderr.strip()}")
    out(f" >>> done -- now `{NAME} --install` as {cfg.sync_user}")
    return 0


def app_running() -> bool:
    """macOS: Syncthing.app's own syncthing -- it would fight the service for the same config."""
    return ON_MAC and run(["pgrep", "-f", "Syncthing.app/Contents/Resources/syncthing/syncthing"]).returncode == 0


def ensure_service(cfg: Config, kind: str) -> bool:
    """Syncthing installed, its identity there, its service running. True when started now."""
    PHASE[0] = "installing Syncthing"
    binary = syncthing_bin()
    if not binary:
        brew = shutil.which("brew") if ON_MAC else ""
        if not brew:
            err("00048", "syncthing is not installed -- install the 'syncthing' package "
                "(it needs root here), then run --install again")
        p = run([brew, "install", "syncthing"], "Syncthing is not installed", capture=False, changes=True)
        if p.returncode != 0:
            err("00049", f"brew install syncthing failed [rc {p.returncode}]")
        binary = syncthing_bin() or "syncthing"
        out(f"    > syncthing installed (it was missing) [{binary}]")
    if app_running():
        err("00050", "Syncthing.app is running -- quit it (menu bar icon > Quit) and remove it from "
            "System Settings > General > Login Items, then run --install again: the service replaces it "
            "and uses the same config, so this device keeps its identity")
    home = syncthing_home(cfg)
    if not os.path.isfile(os.path.join(home, "cert.pem")):
        p = run([binary, "generate"] + ([f"--home={home}"] if cfg.syncthing_home else []),
                "this device's identity", changes=True)
        if p.returncode != 0:
            err("00051", f"syncthing generate failed [rc {p.returncode}]: {p.stderr.strip()}")
        out(f"    > {home}: identity and config created (there was none)")
    if kind == "daemon":
        ok = run(["launchctl", "print", f"system/{LABEL}"]).returncode == 0 if ON_MAC else \
            run(["systemctl", "is-active", f"syncthing@{this_user()}.service"]).stdout.strip() == "active"
        if not ok:
            err("00052", f"SERVICE=daemon: the boot-time service is not installed -- needs root, once:\n"
                f"        > {NAME} --install          (as root)\n    then `{NAME} --install` again as {this_user()}")
        return False
    if ON_MAC:
        path = os.path.expanduser(f"~/Library/LaunchAgents/{LABEL}.plist")
        log = os.path.join(state_dir(cfg), "syncthing.log")
        changed = write_file(path, plist(LABEL, serve_args(cfg, binary), {
            "RunAtLoad": True, "KeepAlive": True, "ProcessType": "Background",
            "StandardOutPath": log, "StandardErrorPath": log}), "Syncthing while you are logged in")
        if not OUT.simulate:
            os.makedirs(state_dir(cfg), exist_ok=True)
        before = run(["launchctl", "print", f"gui/{os.getuid()}/{LABEL}"]).returncode == 0
        launchd_load(f"gui/{os.getuid()}", LABEL, path, changed)
        return changed or not before
    unit = "syncthing.service"
    if run(["systemctl", "--user", "is-active", unit]).stdout.strip() == "active":
        return False
    p = run(["systemctl", "--user", "enable", "--now", unit], "Syncthing while you are logged in", changes=True)
    if p.returncode != 0:
        err("00053", f"systemctl --user enable --now {unit} failed [rc {p.returncode}]: {p.stderr.strip()}")
    return True


def ensure_check_agent(cfg: Config) -> None:
    PHASE[0] = "installing the check agent"
    me = os.path.abspath(sys.argv[0])
    argv = [me, "check", "-Q"] + (["--config", cfg.path] if cfg.path else [])
    if ON_MAC:
        path = os.path.expanduser(f"~/Library/LaunchAgents/{CHECK_LABEL}.plist")
        changed = write_file(path, plist(CHECK_LABEL, argv, {"StartInterval": cfg.check_interval, "RunAtLoad": True}),
                             f"runs `check` every {cfg.check_interval}s")
        launchd_load(f"gui/{os.getuid()}", CHECK_LABEL, path, changed)
        return
    d = os.path.expanduser("~/.config/systemd/user")
    a = write_file(os.path.join(d, f"{CHECK_LABEL}.service"),
                   f"[Unit]\nDescription={NAME} check\n\n[Service]\nType=oneshot\nExecStart={shlex.join(argv)}\n"
                   .encode(), "runs `check`")
    b = write_file(os.path.join(d, f"{CHECK_LABEL}.timer"),
                   f"[Unit]\nDescription={NAME} check\n\n[Timer]\nOnBootSec=2min\nOnUnitActiveSec="
                   f"{cfg.check_interval}s\n\n[Install]\nWantedBy=timers.target\n".encode(),
                   f"every {cfg.check_interval}s")
    if a or b:
        run(["systemctl", "--user", "daemon-reload"], "the units changed", changes=True)
        run(["systemctl", "--user", "enable", "--now", f"{CHECK_LABEL}.timer"], "start it", changes=True)


def cmd_install(cfg: Config) -> int:
    host = this_host()
    if os.getuid() == 0:
        return install_root(cfg)
    user = this_user()
    if cfg.sync_user and cfg.sync_user != user:
        err("00054", f"SYNC_USER is '{cfg.sync_user}', this is '{user}' -- run --install as {cfg.sync_user}")
    if not cfg.hub:
        err("00055", f"HUB is empty -- the config ({cfg.path}) names no hub")
    kind = cfg.service_of(host)
    out(f" >>> {host} ({'hub' if host == cfg.hub else 'peer'}; SERVICE={kind}) as {user}")
    started = ensure_service(cfg, kind) if kind != "none" else False
    api = connect(cfg)
    wait_up(api, 60 if started else 5)
    PHASE[0] = "comparing this host with the config"
    my_id = jstr(api.obj("/rest/system/status"), "myID")
    twin = [h for h, d in cfg.devices.items() if d == my_id and h != host]
    if twin:
        err("00056", f"this device's ID [{my_id[:7]}] is {twin[0]}'s in the config -- a copied Syncthing config? "
            f"Each host needs its own identity: never copy cert.pem/key.pem between hosts")
    if host not in cfg.devices:
        lacking = [f.id for f in cfg.folders.values() if host not in f.hosts]
        out(f" >>> {host} is not in the config yet -- add, in {cfg.path}:")
        out(f"        DEVICE_{host}={my_id}")
        if lacking:
            out(f"    > and '{host}' to hosts= of the folder(s) it should sync: {', '.join(sorted(lacking))}")
        out(f"    > then `{NAME} --install` here, and on the hub {cfg.hub}")
        return 1
    if cfg.devices[host] != my_id:
        err("00057", f"this device's ID is {my_id}, the config says DEVICE_{host}={cfg.devices[host]} -- "
            f"a new identity? Fix the config line; never copy cert.pem/key.pem between hosts")
    if host != cfg.hub and cfg.hub not in cfg.devices:
        err("00058", f"the hub {cfg.hub} has no DEVICE_ line -- its --install prints it")
    PHASE[0] = "making this host match the config"
    plan = make_plan(cfg, api, host, my_id)
    for c in plan.changes:
        out(f"    > {c.why}")
        api.write(c)
    for n in plan.notes:
        out(f"    > {n}")
    for b in plan.blocked:
        sys.stderr.write(f"!!! REFUSED: {b}\n")
    if not OUT.simulate and any(c.path == "/rest/config/gui" for c in plan.changes):
        api = connect(cfg)               # the web UI -- and so the API -- changed scheme
        wait_up(api, 30)
    trusted = True
    if plan.cert:
        api, trusted = fix_gui_cert(cfg, api, plan.cert)
    if cfg.check_agent:
        ensure_check_agent(cfg)
    made = "would be made (-S)" if OUT.simulate else "made"
    n = len(plan.todo())
    if trusted:
        out(f" >>> {'nothing to change: as configured' if not n else f'{n} change(s) {made}'} [{n}]")
    else:                                # the one change a run cannot force: macOS asks a person
        out(f" >>> 1 change NOT made: the web UI certificate is not trusted [made {n - 1} of {n}]")
    if host != cfg.hub and cfg.connect_wait and not OUT.simulate:
        wait_hub(cfg, api)
    return 1 if plan.blocked or not trusted else 0


def fix_gui_cert(cfg: Config, api: Api, work: CertWork) -> tuple[Api, bool]:
    """A web UI certificate the browser accepts at https://127.0.0.1: one for 127.0.0.1, localhost
    and this host's name, CERT_DAYS long -- Syncthing keeps one it did not generate and serves it
    after a restart -- and, on macOS, trusted for TLS in the login keychain. Returns the API,
    reconnected when Syncthing restarted, and False when macOS refused the trust."""
    out(f"    > {work.why}")
    cert, key = os.path.join(api.home, "https-cert.pem"), os.path.join(api.home, "https-key.pem")
    if work.renew:
        host = this_host()
        out(f"    > web UI certificate: a new one for 127.0.0.1, localhost and {host}, {CERT_DAYS} days")
        if not OUT.simulate:
            tmp = tempfile.mkdtemp(dir=api.home, prefix=".tmp.cert.")
            try:
                # named_curve: LibreSSL (macOS's openssl) writes explicit parameters by default, a
                # key Syncthing cannot load -- it then makes a certificate of its own instead
                p = run(["openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:P-256",
                         "-pkeyopt", "ec_param_enc:named_curve", "-nodes",
                         "-days", str(CERT_DAYS), "-subj", f"/O={NAME}/CN={host}",
                         "-addext", f"subjectAltName=IP:127.0.0.1,IP:::1,DNS:localhost,DNS:{host}",
                         "-addext", "extendedKeyUsage=serverAuth", "-addext", "basicConstraints=critical,CA:FALSE",
                         "-keyout", os.path.join(tmp, "key"), "-out", os.path.join(tmp, "cert")], "the certificate")
                if p.returncode != 0:
                    err("00059", f"openssl could not make the web UI certificate [rc {p.returncode}]: "
                        f"{p.stderr.strip()}")
                os.chmod(os.path.join(tmp, "key"), 0o600)
                os.chmod(os.path.join(tmp, "cert"), 0o644)
                os.replace(os.path.join(tmp, "key"), key)
                os.replace(os.path.join(tmp, "cert"), cert)
            finally:
                shutil.rmtree(tmp, ignore_errors=True)
        api = restart(cfg, api)          # Syncthing reads its certificate when it starts
    if ON_MAC and shutil.which("security") and (OUT.simulate or run(
            ["security", "verify-cert", "-c", cert, "-p", "ssl", "-n", "127.0.0.1", "-L", "-q"]).returncode != 0):
        out(f"    > web UI certificate: trusted for TLS in {keychain()} -- macOS asks for your password")
        p = run(["security", "add-trusted-cert", "-r", "trustRoot", "-p", "ssl", "-k", keychain(), cert],
                "trust it", changes=True)
        if p.returncode != 0:
            sys.stderr.write(f"WARNING: the web UI certificate is not trusted [rc {p.returncode}]: "
                             f"{p.stderr.strip()} -- macOS shows the dialog only to a process of the "
                             f"screen's login session (not under ssh, su or launchctl asuser): in a "
                             f"Terminal at this Mac's screen, run `{NAME} --install` again\n")
            return api, False
    return api, True


def wait_hub(cfg: Config, api: Api) -> None:
    """After --install on a peer: the first connection to the hub, or why not."""
    PHASE[0] = f"waiting for the hub {cfg.hub}"
    start = time.time()
    while True:
        c = jsub(jsub(api.obj("/rest/system/connections"), "connections"), cfg.devices[cfg.hub])
        if c.get("connected") is True:
            out(f" >>> connected to the hub {cfg.hub} via {jstr(c, 'address')} [after {time.time() - start:.0f}s]")
            return
        if time.time() - start >= cfg.connect_wait:
            break
        time.sleep(1)
    sys.stderr.write(f"WARNING: no connection to the hub {cfg.hub} after {cfg.connect_wait}s "
                     f"[dials {', '.join(cfg.hub_addresses) or 'nothing'}] -- is Syncthing running there, and does "
                     f"its firewall let TCP in on {', '.join(cfg.hub_listen)}? `{NAME} doctor` tells more\n")


def cmd_uninstall(cfg: Config) -> int:
    """The check agent and this user's Syncthing service go; data and identity stay."""
    if ON_MAC:
        for label in (CHECK_LABEL, LABEL):
            path = os.path.expanduser(f"~/Library/LaunchAgents/{label}.plist")
            if run(["launchctl", "print", f"gui/{os.getuid()}/{label}"]).returncode == 0:
                run(["launchctl", "bootout", f"gui/{os.getuid()}/{label}"], "stop it", changes=True)
            if os.path.exists(path):
                out(f"    > {path} removed")
                if not OUT.simulate:
                    os.remove(path)
        if run(["launchctl", "print", f"system/{LABEL}"]).returncode == 0:
            out(f"    > the boot-time service stays -- root removes it: launchctl bootout system/{LABEL} "
                f"&& rm /Library/LaunchDaemons/{LABEL}.plist")
    else:
        run(["systemctl", "--user", "disable", "--now", f"{CHECK_LABEL}.timer", "syncthing.service"],
            "stop them", changes=True)
    out(f" >>> uninstalled: the check agent and the service -- the folders and {syncthing_home(cfg)} stay")
    return 0


