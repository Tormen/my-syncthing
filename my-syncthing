def build_id() -> str:
    """A hash of the running file: two installs compare by their --version."""
    with open(os.path.realpath(__file__), "rb") as fh:
        return hashlib.sha256(fh.read()).hexdigest()[:12]


def version_string() -> str:
    here = os.path.dirname(os.path.realpath(__file__))
    desc = ""
    if shutil.which("git"):
        # git's tags are this tool's releases only in its OWN repository, whose
        # top is this directory; a copy deployed into another repository would
        # report that one's tags. There the stamp answers.
        top = subprocess.run(["git", "-C", here, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
        if top.returncode == 0 and os.path.realpath(top.stdout.strip()) == here:
            p = subprocess.run(["git", "-C", here, "describe", "--tags", "--long"], capture_output=True, text=True)
            desc = p.stdout.strip() if p.returncode == 0 else ""
    desc = desc or SCRIPT_RELEASE
    m = re.fullmatch(r"(.+)-([0-9]+)-g([0-9a-f]+)", desc)
    if m:
        n = int(m.group(2))
        what = f"the {m.group(1)} tag" if n == 0 else f"{n} commit(s) past {m.group(1)}, unreleased"
        return f"{NAME} {VERSION}{'' if n == 0 else f'+{n}'} ({desc}: {what}, build {build_id()})"
    if SCRIPT_COMMIT:
        return f"{NAME} {VERSION} (commit {SCRIPT_COMMIT}, build {build_id()})"
    return f"{NAME} {VERSION} (build {build_id()}, unstamped)"


def stamp_version() -> int:
    """Record HEAD and git's describe string in this file, then AMEND the
    commit that carries it. After committing, BEFORE pushing; tag afterwards.
    The stamped sha lags HEAD by one: a commit cannot contain its own sha."""
    me = os.path.realpath(__file__)
    here, rel = os.path.dirname(me), os.path.basename(me)

    def git(*a: str) -> subprocess.CompletedProcess[str]:
        return subprocess.run(["git", "-C", here, *a], capture_output=True, text=True)

    if git("rev-parse", "--git-dir").returncode != 0:
        err("00060", "--stamp-version: not a git checkout")
    if git("rev-parse", "--abbrev-ref", "@{upstream}").returncode == 0 and \
            git("merge-base", "--is-ancestor", "HEAD", "@{upstream}").returncode == 0:
        err("00061", "--stamp-version: HEAD is already pushed -- amending would rewrite published history")
    if not git("show", "--name-only", "--format=", "HEAD", "--", rel).stdout.strip():
        err("00062", "--stamp-version: HEAD does not touch this file -- commit it first")
    staged = git("diff", "--cached", "--name-only").stdout.split()
    if staged:
        err("00063", f"--stamp-version: something is staged, the amend would fold it in: {' '.join(staged)}")
    if git("diff", "--quiet", "--", rel).returncode != 0:
        err("00064", "--stamp-version: this file has uncommitted edits -- commit them first")
    sha = git("rev-parse", "--short", "HEAD").stdout.strip()
    desc = git("describe", "--tags", "--long").stdout.strip()
    with open(me) as fh:
        src = fh.read()
    new, n1 = re.subn(r'^SCRIPT_COMMIT = .*$', f'SCRIPT_COMMIT = "{sha}"', src, count=1, flags=re.M)
    new, n2 = re.subn(r'^SCRIPT_RELEASE = .*$', f'SCRIPT_RELEASE = "{desc}"', new, count=1, flags=re.M)
    if (n1, n2) != (1, 1):
        err("00065", "--stamp-version: the stamp lines are not there")
    fd, tmp = tempfile.mkstemp(dir=here, prefix=f".{NAME}.stamp.")
    with os.fdopen(fd, "w") as fh:
        fh.write(new)
    shutil.copymode(me, tmp)
    os.replace(tmp, me)
    if git("add", "--", rel).returncode != 0 or git("commit", "--amend", "--no-edit").returncode != 0:
        err("00066", "--stamp-version: git add / commit --amend failed")
    out(f"stamped SCRIPT_COMMIT={sha} SCRIPT_RELEASE={desc or '<no tag yet>'} -- "
        f"HEAD is now {git('rev-parse', '--short', 'HEAD').stdout.strip()}")
    return 0


