def internal_error(log_root: str) -> int:
    """An exception nothing expected: one line on stderr, the trace in a file."""
    import traceback
    e = sys.exc_info()[1]
    d = log_root if os.path.isdir(log_root) else tempfile.gettempdir()
    path = os.path.join(d, f"{NAME}.trace")
    try:
        with open(path, "w") as fh:
            fh.write(f"{version_string()} while {PHASE[0]}\n")
            traceback.print_exc(file=fh)
        where = f"the trace is in {path}"
    except OSError:
        where = "the trace could not be written"
    sys.stderr.write(f"ERROR 00067 [70]: internal error while {PHASE[0]}: {type(e).__name__}: {e} -- {where}\n")
    return 70


def main(argv: Sequence[str], log_root: str = "") -> int:
    logs = log_root or default_state_dir()
    try:
        return _main(list(argv))
    except Err as e:
        sys.stderr.write(f"ERROR {e.code} [{e.exit_code}]: {e.msg}\n")
        return e.exit_code
    except KeyboardInterrupt:
        sys.stderr.write(f"{NAME}: interrupted (Ctrl-C) while {PHASE[0]} -- what was done before stays, "
                         f"nothing is half-written; run it again to go on\n")
        return 130
    except Exception:
        return internal_error(logs)


def _main(args: list[str]) -> int:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    OUT.quiet = OUT.vrb = OUT.dbg = OUT.simulate = False
    PHASE[0] = "reading the arguments"
    config = ""
    rest: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "-S":
            OUT.simulate = True
        elif a == "-Q":
            OUT.quiet = True
        elif a == "-V":
            OUT.vrb = True
        elif a == "-D":
            OUT.dbg = OUT.vrb = True
        elif a == "--config" or a.startswith("--config="):
            if a == "--config":
                i += 1
                if i >= len(args):
                    err("00068", "--config needs a <FILE>")
                config = args[i]
            else:
                config = a.split("=", 1)[1]
        else:
            rest.append(a)
        i += 1
    if OUT.vrb:
        OUT.quiet = False                              # -V beats -Q
    verb, vargs = (rest[0], rest[1:]) if rest else ("", [])
    if verb in ("-h", "--help"):
        sys.stdout.write(USAGE)
        return 0
    if verb == "--version":
        sys.stdout.write(version_string() + "\n")
        return 0
    if verb == "--run-tests":
        return run_tests(vargs[0] if vargs else "")
    if verb == "--stamp-version":
        return stamp_version()
    if verb == "--create-config" or verb.startswith("--create-config="):
        return create_config(verb.split("=", 1)[1] if "=" in verb else (vargs[0] if vargs else ""))
    if verb.startswith("--") and verb[2:] in VERBS:
        err("00069", f"no such option '{verb}' -- you mean `{NAME} {verb[2:]}`")
    if verb.startswith("-") and verb not in FLAGS:
        err("00070", f"unknown option '{verb}' -- `{NAME} --help`")
    if verb and not verb.startswith("-") and verb not in VERBS:
        err("00071", f"no verb '{verb}' -- {', '.join(VERBS)} (`{NAME} --help`)")
    if verb not in ("enable", "disable", "doctor", "rescan", "diag") and vargs:
        err("00072", f"'{verb or NAME}' takes no argument: {' '.join(vargs)}")
    PHASE[0] = "reading the config"
    cfg = read_config(find_config(config))
    install_completion()
    if verb == "":
        sys.stdout.write("" if OUT.quiet else SHORT_USAGE + "\n")
        PHASE[0] = "reading the status"
        return cmd_status(cfg)
    PHASE[0] = f"running {verb}"
    table: dict[str, Callable[[], int]] = {
        "status": lambda: cmd_status(cfg),
        "enable": lambda: cmd_pause(cfg, vargs, False),
        "disable": lambda: cmd_pause(cfg, vargs, True),
        "web": lambda: cmd_web(cfg),
        "check": lambda: cmd_check(cfg),
        "diag": lambda: cmd_diag(cfg, vargs),
        "doctor": lambda: cmd_doctor(cfg, vargs),
        "rescan": lambda: cmd_rescan(cfg, vargs),
        "restart": lambda: cmd_restart(cfg),
        "--export-cert": lambda: cmd_export_cert(cfg),
        "--install": lambda: cmd_install(cfg),
        "--uninstall": lambda: cmd_uninstall(cfg),
        "--test-mail": lambda: cmd_test_mail(cfg),
    }
    return table[verb]()


