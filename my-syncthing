    t.conf(GUI_TLS="yes")
    os.symlink(libre, t.p("bin", "openssl"))
    t.run("--install")
    key = subprocess.run([libre, "pkey", "-in", t.p("st", "https-key.pem"), "-noout", "-text"],
                         capture_output=True, text=True).stdout
    t.is_("--install with LibreSSL's openssl: the key names its curve, as Syncthing can load it",
          ("ASN1 OID: prime256v1" in key, "Field Type" in key), (True, False))


