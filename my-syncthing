CHECK_AGENT=yes           # --install also installs the agent that runs `check`
CHECK_INTERVAL=5m
CONNECT_WAIT=60s          # --install on a peer then waits this long for the hub; 0s: not
GUI_TLS=""                # the web UI over https: yes or no; empty: left as it is
STATE_DIR=""              # my-syncthing's own state; empty: the platform's
                          # per-user state directory

## check: the conditions that count, and when a held one is told
CONDITIONS="not-running hub-unreachable folder-error conflicts out-of-sync drift"
HUB_GRACE=15m             # hub-unreachable counts after this long
