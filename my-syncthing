PEER_LISTEN="tcp://127.0.0.1:22000"   # a peer listens on loopback only: it dials, nobody dials it
PHONE_HOME=no             # no: global and LAN announce, relays, NAT, usage
                          # reports, upgrade check and crash reports all off

