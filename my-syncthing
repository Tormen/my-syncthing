# ---------------------------------------------------------------------------
# failure

class Err(Exception):
    """The tool's one failure; its code names the line that raised it."""

    def __init__(self, code: str, msg: str, exit_code: int = 2) -> None:
        super().__init__(msg)
        self.code = code
        self.msg = msg
        self.exit_code = exit_code


def err(code: str, msg: str, exit_code: int = 2) -> NoReturn:
    raise Err(code, msg, exit_code)


class Down(Err):
    """Syncthing does not answer: a condition for status, an error elsewhere."""


# What the run is doing right now -- said when it is interrupted (Ctrl-C).
PHASE = ["starting"]


# ---------------------------------------------------------------------------
# output: standard on stdout (-Q silences it), -V and -D add, errors on stderr

@dataclass
class Out:
    quiet: bool = False
    vrb: bool = False
    dbg: bool = False
    simulate: bool = False


OUT = Out()


def out(line: str) -> None:
    if not OUT.quiet:
        sys.stdout.write(line + "\n")


def say(line: str) -> None:
    """-V: a command or request about to run."""
    if OUT.vrb:
        sys.stdout.write(f" >>> {line}\n")


def dbg(line: str) -> None:
    if OUT.dbg:
        sys.stderr.write(f" ~~~ {line}\n")


def warn(line: str) -> None:
    sys.stderr.write(f"{NAME}: {line}\n")


def run(cmd: Sequence[str], why: str = "", capture: bool = True,
        changes: bool = False) -> subprocess.CompletedProcess[str]:
    """Run a command; one that CHANGES something is only printed under -S."""
    say(shlex.join(cmd) + (f"    # {why}" if why else ""))
    if changes and OUT.simulate:
        out(f"    > (-S) would run: {shlex.join(cmd)}")
        return subprocess.CompletedProcess(list(cmd), 0, "", "")
    sys.stdout.flush()
    try:
        return subprocess.run(list(cmd), capture_output=capture, text=True)
    except OSError as e:
        err("00001", f"cannot run {cmd[0]}: {e.strerror}")


