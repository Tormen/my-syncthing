class Folder:
    id: str
    path: str
    hosts: tuple[str, ...]
    label: str
    versioning: str                   # "" (none), staggered, trashcan, simple
    params: tuple[tuple[str, str], ...]
    ignore: tuple[str, ...]
    ignore_perms: bool
    xattrs: bool


@dataclass(frozen=True)
class Config:
    path: str                         # the file read; "" for the defaults only
    hub: str
    hub_addresses: tuple[str, ...]
    hub_listen: tuple[str, ...]
    peer_listen: tuple[str, ...]
    phone_home: bool
    sync_user: str
    service: str
    services: dict[str, str]
    syncthing_home: str
    check_agent: bool
    check_interval: int
    state_dir: str
    conditions: tuple[str, ...]
    hub_grace: int
    sync_grace: int
    alert_now: str
    alert_later: str
    alert_delay: int
    connect_wait: int
    gui_tls: str                      # "", yes, no
    devices: dict[str, str]           # host -> device ID
    folders: dict[str, Folder]

    def service_of(self, host: str) -> str:
        return self.services.get(host, self.service)

    def name_of(self, device: str) -> str:
        return next((h for h, d in self.devices.items() if d == device), device[:7])


def duration(text: str, what: str) -> int:
    """30s, 10m, 2h, 3d -> seconds."""
    m = re.fullmatch(r"([0-9]+)([smhd])", text.strip())
    if not m:
        err("00002", f"{what}='{text}': not a duration -- a number and s, m, h or d (30m)")
    return int(m.group(1)) * {"s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]


def yes(text: str, what: str) -> bool:
    if text not in ("yes", "no"):
        err("00003", f"{what}='{text}': yes or no")
    return text == "yes"


def parse_versioning(text: str, what: str) -> tuple[str, tuple[tuple[str, str], ...]]:
    if text in ("", "none"):
        return "", ()
    m = re.fullmatch(r"(staggered|trashcan|simple):([0-9]+)(d?)", text)
    if not m or (m.group(1) != "simple") != (m.group(3) == "d"):
        err("00004", f"{what}: versioning='{text}' -- staggered:<N>d, trashcan:<N>d, simple:<N> or none")
    n = int(m.group(2))
    kind = m.group(1)
    if kind == "staggered":
        return kind, (("maxAge", str(n * 86400)),)
    if kind == "trashcan":
        return kind, (("cleanoutDays", str(n)),)
    return kind, (("keep", str(n)),)


def parse_folder(fid: str, spec: str) -> Folder:
    what = f"FOLDER_{fid}"
    try:
        words = shlex.split(spec)
    except ValueError as e:
        err("00005", f"{what}: {e}")
    if not words or "=" in words[0]:
        err("00006", f"{what}: the first word is the folder's path -- '{spec.strip()}'")
    kv: dict[str, str] = {}
    for w in words[1:]:
        k, eq, v = w.partition("=")
        if not eq or k not in FOLDER_KEYS:
            err("00007", f"{what}: '{w}' -- the keys are {', '.join(FOLDER_KEYS)}")
        kv[k] = v
    hosts = tuple(h.lower() for h in kv.get("hosts", "").split(",") if h)
    if not hosts:
        err("00008", f"{what}: hosts= is required -- which hosts sync it")
    if kv.get("perms", "ignore") not in ("ignore", "sync"):
        err("00009", f"{what}: perms='{kv['perms']}' -- ignore or sync")
    if kv.get("xattrs", "off") not in ("off", "on"):
        err("00010", f"{what}: xattrs='{kv['xattrs']}' -- off or on")
    vt, vp = parse_versioning(kv.get("versioning", ""), what)
    return Folder(id=fid, path=words[0], hosts=hosts, label=kv.get("label", fid), versioning=vt,
                  params=vp, ignore=tuple(p for p in kv.get("ignore", "").split(",") if p),
                  ignore_perms=kv.get("perms", "ignore") == "ignore", xattrs=kv.get("xattrs") == "on")


def config_search_paths() -> list[str]:
    """Where the config is looked for, after $MY_SYNCTHING_CONFIG and --config."""
    links = os.environ.get("LINKS") or "/LINKS"
    return [f"{links}/default/{NAME}.conf", f"{links}/default/{NAME}",
            os.path.expanduser(f"~/.{NAME}.conf"), f"/etc/{NAME}.conf", f"/usr/local/etc/{NAME}.conf"]


def find_config(named: str) -> str:
    """The config file in effect: $MY_SYNCTHING_CONFIG, --config, the search."""
    env = os.environ.get(CONFIG_ENV, "")
    explicit = env or named
    if explicit:
        if not os.path.isfile(explicit):
            err("00011", f"config file '{explicit}' is not there ({'$' + CONFIG_ENV if env else '--config'})")
        return explicit
    found = next((p for p in config_search_paths() if os.path.isfile(p)), "")
    if found:
        return found
    search = config_search_paths()
    offer = [p for p in (f"/etc/{NAME}.conf", os.path.expanduser(f"~/.{NAME}.conf")) if p in search]
    err("00012", "no config found -- the cluster (hub, devices, folders) is site-specific;\n"
        "    --> write one, most common place first (all places: --help):\n"
        + "\n".join(f"        > {NAME} --create-config > {p}" for p in offer))


def read_config(path: str) -> Config:
    """Source the defaults, then the file, in /bin/sh; read the variables back."""
    script = ('set -a; eval "$MY_SYNCTHING_DEFAULTS" || exit 3; [ -z "$1" ] || . "$1" || exit 4; '
              'exec "$2" -I -S -c "import os, json, sys; json.dump(dict(os.environ), sys.stdout)"')
    env = {k: v for k, v in os.environ.items() if k in ("PATH", "HOME", "USER", "LOGNAME", "LINKS")}
    env["MY_SYNCTHING_DEFAULTS"] = DEFAULT_CONFIG
    p = subprocess.run(["/bin/sh", "-c", script, "sh", path, sys.executable], env=env,
                       capture_output=True, text=True)
    if p.returncode != 0:
        err("00013", f"the config '{path}' could not be read by /bin/sh [rc {p.returncode}]: "
            f"{p.stderr.strip() or 'no message'}")
    raw = cast(dict[str, str], json.loads(p.stdout))

    def v(k: str) -> str:
        return raw.get(k, "").strip()
    devices: dict[str, str] = {}
    folders: dict[str, Folder] = {}
    services: dict[str, str] = {}
    for k, val in raw.items():
        if k.startswith("DEVICE_"):
            if not DEVICE_ID.fullmatch(val.strip()):
                err("00014", f"{k}='{val}': not a device ID (8 groups of 7, A-Z and 2-7)")
            devices[k[len("DEVICE_"):].lower()] = val.strip()
        elif k.startswith("FOLDER_"):
            folders[k[len("FOLDER_"):]] = parse_folder(k[len("FOLDER_"):], val)
        elif k.startswith("SERVICE_"):
            services[k[len("SERVICE_"):].lower()] = val.strip()
    for k, s in [("SERVICE", v("SERVICE"))] + [(f"SERVICE_{h}", s) for h, s in services.items()]:
        if s not in SERVICES:
            err("00015", f"{k}='{s}' -- {', '.join(SERVICES)}")
    conds = tuple(v("CONDITIONS").split())
    for c in conds:
        if c not in CONDITION_NAMES:
            err("00016", f"CONDITIONS: '{c}' -- the conditions are {', '.join(CONDITION_NAMES)}")
    if v("GUI_TLS") not in ("", "yes", "no"):
        err("00017", f"GUI_TLS='{v('GUI_TLS')}' -- yes, no, or empty (left as it is)")
    hub = v("HUB").lower()       # host names compare as this_host() gives them
    for f in folders.values():
        if hub and hub not in f.hosts:
            err("00018", f"FOLDER_{f.id}: hosts= lacks the hub '{hub}' -- every folder goes through it")
    return Config(
        path=path, hub=hub, hub_addresses=tuple(v("HUB_ADDRESSES").split()),
        hub_listen=tuple(v("HUB_LISTEN").split()), peer_listen=tuple(v("PEER_LISTEN").split()),
        phone_home=yes(v("PHONE_HOME"), "PHONE_HOME"), sync_user=v("SYNC_USER"),
        service=v("SERVICE"), services=services, syncthing_home=v("SYNCTHING_HOME"),
        check_agent=yes(v("CHECK_AGENT"), "CHECK_AGENT"),
        check_interval=duration(v("CHECK_INTERVAL"), "CHECK_INTERVAL"), state_dir=v("STATE_DIR"),
        conditions=conds, hub_grace=duration(v("HUB_GRACE"), "HUB_GRACE"),
        sync_grace=duration(v("SYNC_GRACE"), "SYNC_GRACE"), alert_now=v("ALERT_NOW"),
        alert_later=v("ALERT_LATER"), alert_delay=duration(v("ALERT_DELAY"), "ALERT_DELAY"),
        connect_wait=duration(v("CONNECT_WAIT"), "CONNECT_WAIT"), gui_tls=v("GUI_TLS"),
        devices=devices, folders=folders)


def create_config(target: str) -> int:
    """--create-config [FILE]: the defaults on stdout, or into FILE (never over one)."""
    if not target:
        sys.stdout.write(DEFAULT_CONFIG)
        return 0
    if os.path.lexists(target):
        err("00019", f"'{target}' exists -- not overwritten; remove it first, or write elsewhere")
    tmp = f"{target}.{NAME}-{os.getpid()}"
    try:
        with open(tmp, "w") as fh:
            fh.write(DEFAULT_CONFIG)
        os.chmod(tmp, 0o644)
        os.replace(tmp, target)
    except OSError as e:
        err("00020", f"cannot write '{target}': {e.strerror}")
    out(f"{NAME}: the default config written to {target}")
    return 0


# ---------------------------------------------------------------------------
# this host

def this_host() -> str:
    """The short host name as the config names it: lower case, and anything a
    shell variable name cannot hold as '_' (My-Laptop: DEVICE_my_laptop)."""
    return re.sub(r"[^a-z0-9_]", "_", socket.gethostname().split(".")[0].lower())


def this_user() -> str:
    import pwd
    return pwd.getpwuid(os.getuid()).pw_name


def syncthing_home(cfg: Config) -> str:
    """Syncthing's config directory: the configured one, else its default."""
    if cfg.syncthing_home:
        return os.path.expanduser(cfg.syncthing_home)
    if ON_MAC:
        return os.path.expanduser("~/Library/Application Support/Syncthing")
    state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    for d in (os.path.join(state, "syncthing"), os.path.expanduser("~/.config/syncthing")):
        if os.path.isfile(os.path.join(d, "config.xml")):
            return d
    return os.path.join(state, "syncthing")


def state_dir(cfg: Config) -> str:
    return os.path.expanduser(cfg.state_dir) if cfg.state_dir else default_state_dir()


def default_state_dir() -> str:
    """The platform's per-user state directory for this tool."""
    if ON_MAC:
        return os.path.expanduser(f"~/Library/Application Support/{NAME}")
    return os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), NAME)


def load_state(cfg: Config) -> dict[str, dict[str, dict[str, float]]]:
    path = os.path.join(state_dir(cfg), "state.json")
    try:
        with open(path) as fh:
            data = json.load(fh)
    except FileNotFoundError:
        return {"conditions": {}, "disabled": {}}
    except (OSError, ValueError) as e:
        err("00021", f"cannot read my state '{path}': {e}")
    if not isinstance(data, dict):
        err("00022", f"my state '{path}' is not a JSON object -- remove it, the next run starts afresh")
    st = cast(dict[str, dict[str, dict[str, float]]], data)
    st.setdefault("conditions", {})
    st.setdefault("disabled", {})
    return st


def save_state(cfg: Config, st: dict[str, dict[str, dict[str, float]]]) -> None:
    """Temp file + rename: an interrupt never leaves half a state."""
    if OUT.simulate:
        return
    d = state_dir(cfg)
    try:
        os.makedirs(d, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=d, prefix=".state.")
        with os.fdopen(fd, "w") as fh:
            json.dump(st, fh, indent=1, sort_keys=True)
        os.replace(tmp, os.path.join(d, "state.json"))
    except OSError as e:
        err("00023", f"cannot write my state in '{d}': {e.strerror}")


# ---------------------------------------------------------------------------
# Syncthing's REST API -- its key goes in a header, never on a command line

JObj = dict[str, object]


def jobj(v: object, what: str) -> JObj:
    if not isinstance(v, dict):
        err("00024", f"Syncthing's answer for {what} is not an object")
    return cast(JObj, v)


def jlist(v: object) -> list[object]:
    return cast(list[object], v) if isinstance(v, list) else []


def jstr(o: JObj, k: str) -> str:
    v = o.get(k)
    return v if isinstance(v, str) else ""


def jint(o: JObj, k: str) -> int:
    v = o.get(k)
    return v if isinstance(v, int) and not isinstance(v, bool) else 0


def jnum(o: JObj, k: str) -> float:
    v = o.get(k)
    return float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) else 0.0


def tls_pin(home: str) -> tuple[ssl.SSLContext, bytes]:
    """What the web UI is trusted by: EXACTLY the certificate in HOME's
    https-cert.pem, compared byte for byte -- not a chain check with it as the
    trust anchor, which Apple's python (LibreSSL 2.8.3) refuses for
    Syncthing's own certificate. The context checks no chain; the pin is the
    check. Read again on every connect: --install swaps the certificate."""
    path = os.path.join(home, "https-cert.pem")
    try:
        with open(path) as fh:
            pin = ssl.PEM_cert_to_DER_cert(fh.read())
    except (OSError, ValueError) as e:
        raise Down("00074", f"no web UI certificate to trust at {path} [{e}]") from e
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    return ctx, pin


class _PinnedHTTPS(http.client.HTTPSConnection):
    """An https connection that is refused unless the server's certificate
    is the pinned one."""
    pin = b""

    def connect(self) -> None:
        super().connect()
        sock = self.sock
        der = sock.getpeercert(binary_form=True) if isinstance(sock, ssl.SSLSocket) else None
        if der != self.pin:
            self.close()
            raise ssl.SSLError("the served certificate is not the certificate in https-cert.pem")


class _PinnedHandler(urllib.request.HTTPSHandler):
    def __init__(self, ctx: ssl.SSLContext, pin: bytes) -> None:
        super().__init__(context=ctx)
        self._ctx, self._pin = ctx, pin

    def https_open(self, req: urllib.request.Request) -> http.client.HTTPResponse:
        pin = self._pin

        class Conn(_PinnedHTTPS):
            pass
        Conn.pin = pin
        return self.do_open(Conn, req, context=self._ctx)  # pyright: ignore[reportUnknownMemberType]  # typeshed: untyped


@dataclass
class Api:
    """One Syncthing instance, found through its own config.xml."""
    base: str
    key: str
    ctx: ssl.SSLContext | None
    home: str
    pin: bytes

    def call(self, method: str, path: str, body: object = None) -> object:
        data = None if body is None else json.dumps(body).encode()
        req = urllib.request.Request(self.base + path, data=data, method=method,
                                     headers={"X-API-Key": self.key, "Content-Type": "application/json"})
        dbg(f"{method} {path}" + (f" {json.dumps(body)}" if body is not None else ""))
        try:
            opener = urllib.request.build_opener(_PinnedHandler(self.ctx, self.pin)) if self.ctx \
                else urllib.request.build_opener()
            with opener.open(req, timeout=20) as r:
                raw = r.read()
        except urllib.error.HTTPError as e:
            err("00025", f"Syncthing refused {method} {path} [HTTP {e.code}]: "
                f"{e.read().decode(errors='replace').strip()[:200]}")
        except (urllib.error.URLError, OSError) as e:
            reason = getattr(e, "reason", e)
            raise Down("00026", f"Syncthing does not answer at {self.base} [{reason}]") from e
        if not raw.strip():
            return None
        try:
            return json.loads(raw)
        except ValueError:
            err("00027", f"Syncthing's answer to {method} {path} is not JSON")

    def get(self, path: str) -> object:
        return self.call("GET", path)

    def obj(self, path: str) -> JObj:
        return jobj(self.get(path), path)

    def write(self, change: Change) -> None:
        if OUT.simulate:
            out(f"    > (-S) would {change.method} {change.path} {json.dumps(change.body)}")
            return
        self.call(change.method, change.path, change.body)


def connect(cfg: Config) -> Api:
    """The API of this user's Syncthing, from its config.xml (address, key, TLS)."""
    home = syncthing_home(cfg)
    conf = os.path.join(home, "config.xml")
    try:
        gui = ET.parse(conf).getroot().find("gui")
    except FileNotFoundError as e:
        raise Down("00028", f"no Syncthing config at {conf} -- not set up for {this_user()}; "
                   f"`{NAME} --install`") from e
    except (OSError, ET.ParseError) as e:
        err("00029", f"cannot read {conf}: {e}")
    if gui is None:
        err("00030", f"{conf} has no <gui> element -- Syncthing's API is not configured")
    addr = (gui.findtext("address") or "").strip()
    key = (gui.findtext("apikey") or "").strip()
    if not addr or not key:
        err("00031", f"{conf}: the GUI address or API key is empty")
    if addr.startswith("/") or addr.startswith("unix"):
        err("00032", f"{conf}: GUI address '{addr}' -- a socket; {NAME} needs host:port")
    tls = gui.get("tls") == "true"
    ctx, pin = tls_pin(home) if tls else (None, b"")
    host = addr.replace("0.0.0.0", "127.0.0.1").replace("[::]", "[::1]")
    return Api(base=f"{'https' if tls else 'http'}://{host}", key=key, ctx=ctx, home=home, pin=pin)


def wait_up(api: Api, seconds: int) -> None:
    PHASE[0] = "waiting for Syncthing to answer"
    end = time.time() + seconds
    while True:
        try:
            api.get("/rest/system/ping")
            return
        except Down:
            if time.time() >= end:
                raise
            time.sleep(1)


# ---------------------------------------------------------------------------
# the plan: what --install would change; `check` calls a non-empty one drift

@dataclass(frozen=True)
class Change:
    method: str
    path: str
    body: object
    why: str                          # one line: what, and why


@dataclass(frozen=True)
class CertWork:
    renew: bool                       # a new certificate; else only trusting the one there
    why: str


@dataclass
class Plan:
    changes: list[Change] = field(default_factory=lambda: [])
    notes: list[str] = field(default_factory=lambda: [])
    blocked: list[str] = field(default_factory=lambda: [])   # differences --install refuses to settle
    cert: CertWork | None = None      # the web UI certificate, when the browser would warn

    def todo(self) -> list[str]:
        """What --install would do, one line each."""
        return [c.why for c in self.changes] + ([self.cert.why] if self.cert else [])


CERT_DAYS: Final = 825                # the longest a Mac accepts a TLS server certificate
CERT_RENEW: Final = 30 * 86400        # replaced this long before it expires


def keychain() -> str:
    return os.path.expanduser("~/Library/Keychains/login.keychain-db")


def cert_work(home: str) -> CertWork | None:
    """Why the web UI certificate makes the browser warn at https://127.0.0.1 (the address `web`
    opens): Syncthing's own is named for the host only, and self-signed. None when it would not,
    or when there is no openssl to tell."""
    openssl = shutil.which("openssl")
    cert = os.path.join(home, "https-cert.pem")
    if not openssl:
        return None
    if not os.path.isfile(cert):
        return CertWork(True, f"web UI certificate: none yet at {cert}")
    san = run([openssl, "x509", "-in", cert, "-noout", "-ext", "subjectAltName"]).stdout
    if "IP Address:127.0.0.1" not in san:
        names = " ".join(san.split("\n", 1)[-1].split()) or "no names"
        return CertWork(True, f"web UI certificate: not for 127.0.0.1 [{names}] -- the browser warns")
    if run([openssl, "x509", "-in", cert, "-noout", "-checkend", str(CERT_RENEW)]).returncode != 0:
        end = run([openssl, "x509", "-in", cert, "-noout", "-enddate"]).stdout.strip().split("=", 1)[-1]
        return CertWork(True, f"web UI certificate: expires within 30 days [{end}]")
    if ON_MAC and shutil.which("security") and run(
            ["security", "verify-cert", "-c", cert, "-p", "ssl", "-n", "127.0.0.1", "-L", "-q"]).returncode != 0:
        return CertWork(False, "web UI certificate: not trusted on this Mac -- the browser warns")
    return None


PHONE_HOME_OFF: Final[dict[str, object]] = {
    "globalAnnounceEnabled": False, "localAnnounceEnabled": False, "relaysEnabled": False,
    "natEnabled": False, "urAccepted": -1, "autoUpgradeIntervalH": 0, "crashReportingEnabled": False,
    "stunKeepaliveStartS": 0}


def show(v: object) -> str:
    return json.dumps(v) if not isinstance(v, str) else v


def diff(have: JObj, want: JObj) -> dict[str, object]:
    return {k: w for k, w in want.items() if have.get(k) != w}


def folder_devices(cfg: Config, f: Folder, host: str) -> list[str]:
    """The hub shares a folder with each of its hosts; a peer with the hub."""
    peers = [h for h in f.hosts if h != host] if host == cfg.hub else [cfg.hub]
    return [cfg.devices[h] for h in [host, *peers] if h in cfg.devices]


def jsub(o: JObj, k: str) -> JObj:
    v = o.get(k)
    return cast(JObj, v) if isinstance(v, dict) else {}


def versioning_ok(have: JObj, f: Folder) -> bool:
    """Equal type, and every parameter we set has our value (Syncthing may add others)."""
    params = jsub(have, "params")
    return jstr(have, "type") == f.versioning and all(params.get(k) == v for k, v in f.params)


def local_changes(api: Api, fid: str) -> int:
    o = api.obj(f"/rest/db/localchanged?folder={fid}")
    return sum(len(jlist(x)) for x in o.values())


def make_plan(cfg: Config, api: Api, host: str, my_id: str) -> Plan:
    p = Plan()
    is_hub = host == cfg.hub
    # options: where it listens, and nothing that calls home
    have = api.obj("/rest/config/options")
    want: JObj = {"listenAddresses": list(cfg.hub_listen if is_hub else cfg.peer_listen), "startBrowser": False}
    if not cfg.phone_home:
        want.update(PHONE_HOME_OFF)
    d = diff(have, want)
    if d:
        p.changes.append(Change("PATCH", "/rest/config/options", d, "options: " + ", ".join(
            f"{k} {show(have.get(k))} -> {show(v)}" for k, v in d.items())))
    # devices: the hub knows every device, a peer the hub
    devs = {jstr(o, "deviceID"): o for o in (jobj(x, "device") for x in jlist(api.get("/rest/config/devices")))}
    wanted: dict[str, JObj] = {my_id: {"name": host}}
    for h, dev in cfg.devices.items():
        if h != host and (is_hub or h == cfg.hub):
            wanted[dev] = {"name": h, "autoAcceptFolders": False,
                           "addresses": ["dynamic"] if is_hub else list(cfg.hub_addresses)}
    for dev, w in wanted.items():
        if dev not in devs:
            p.changes.append(Change("PUT", f"/rest/config/devices/{dev}", {"deviceID": dev, **w},
                                    f"device {w['name']}: added ({'a peer of this hub' if is_hub else 'the hub'})"))
        elif diff(devs[dev], w):
            dd = diff(devs[dev], w)
            p.changes.append(Change("PATCH", f"/rest/config/devices/{dev}", dd, f"device {w['name']}: " + ", ".join(
                f"{k} {show(devs[dev].get(k))} -> {show(v)}" for k, v in dd.items())))
    for dev in devs:
        if dev not in wanted:
            p.notes.append(f"device {jstr(devs[dev], 'name') or dev[:7]} [{dev[:7]}]: not in the config "
                           f"for this host -- left as it is")
    # folders this host is named in
    have_f = {jstr(o, "id"): o for o in (jobj(x, "folder") for x in jlist(api.get("/rest/config/folders")))}
    home = os.path.expanduser("~")
    for f in sorted(cfg.folders.values(), key=lambda x: x.id):
        if host not in f.hosts:
            continue
        missing = [h for h in f.hosts if h not in cfg.devices]
        if missing:
            p.notes.append(f"folder {f.id}: no DEVICE_ line for {', '.join(missing)} -- not shared with them yet")
        path = os.path.join(home, f.path[2:]) if f.path.startswith("~/") else f.path
        want_f: JObj = {
            "label": f.label, "path": path,
            "versioning": {"type": f.versioning, "params": dict(f.params)},
            "ignorePerms": f.ignore_perms, "syncXattrs": f.xattrs, "sendXattrs": f.xattrs,
            "syncOwnership": False, "sendOwnership": False}
        devices = folder_devices(cfg, f, host)
        if f.id not in have_f:
            try:
                full = bool(os.listdir(path))
            except FileNotFoundError:
                full = False
            except OSError:
                full = True              # unreadable: assume data, so nothing is sent before it matches
            # The hub's copy is the reference a peer's existing data is compared
            # with: were the hub receive-only too, nobody would send, and every
            # host would see all its files as local changes for ever.
            adopt = full and not is_hub
            kind = "receiveonly" if adopt else "sendreceive"
            p.changes.append(Change("PUT", f"/rest/config/folders/{f.id}", {
                "id": f.id, "type": kind, "paused": True,
                "devices": [{"deviceID": x} for x in devices], **want_f},
                f"folder {f.id}: added at {path}, {kind}" + (
                    " -- it already holds data: nothing is sent until it matches the hub's" if adopt else
                    " -- the hub: its data is the reference the peers compare with" if full else "")))
            p.changes.append(Change("POST", f"/rest/db/ignores?folder={f.id}", {"ignore": list(f.ignore)},
                                    f"folder {f.id}: ignores {', '.join(f.ignore) or 'none'}"))
            p.changes.append(Change("PATCH", f"/rest/config/folders/{f.id}", {"paused": False},
                                    f"folder {f.id}: started, its ignores in place"))
            continue
        h = have_f[f.id]
        if h.get("path") != path:
            p.blocked.append(f"folder {f.id}: Syncthing has it at {jstr(h, 'path')}, the config says {path} -- "
                             f"moving a synced folder is not {NAME}'s job: change one of the two by hand")
        dd: JObj = {k: w for k, w in want_f.items() if k not in ("versioning", "path") and h.get(k) != w}
        if not versioning_ok(jsub(h, "versioning"), f):
            dd["versioning"] = want_f["versioning"]
        have_devs = sorted(jstr(jobj(x, "folder device"), "deviceID") for x in jlist(h.get("devices")))
        if have_devs != sorted(devices):
            dd["devices"] = [{"deviceID": x} for x in devices]
        if dd:
            p.changes.append(Change("PATCH", f"/rest/config/folders/{f.id}", dd, f"folder {f.id}: " + ", ".join(
                f"{k} -> {show(v) if k != 'devices' else ', '.join(cfg.name_of(x) for x in devices)}"
                for k, v in dd.items())))
        ign = jlist(api.obj(f"/rest/db/ignores?folder={f.id}").get("ignore"))
        if [x for x in ign if isinstance(x, str)] != list(f.ignore):
            p.changes.append(Change("POST", f"/rest/db/ignores?folder={f.id}", {"ignore": list(f.ignore)},
                                    f"folder {f.id}: ignores -> {', '.join(f.ignore) or 'none'}"))
        if jstr(h, "type") == "receiveonly" and h.get("paused") is not True:
            st = jstr(api.obj(f"/rest/db/status?folder={f.id}"), "state")
            n = local_changes(api, f.id)
            if st == "idle" and n == 0:
                p.changes.append(Change("PATCH", f"/rest/config/folders/{f.id}", {"type": "sendreceive"},
                                        f"folder {f.id}: receiveonly -> sendreceive (scanned, nothing differs here)"))
            else:
                p.notes.append(f"folder {f.id}: stays receiveonly -- {n} local change(s), state {st} "
                               f"(`{NAME} diag localchanged`)")
    for fid in have_f:
        if fid not in cfg.folders or host not in cfg.folders[fid].hosts:
            p.notes.append(f"folder {fid}: not in the config for this host -- left as it is")
    if cfg.gui_tls:                  # last: the API changes scheme with it
        gui = api.obj("/rest/config/gui")
        tls = cfg.gui_tls == "yes"
        if gui.get("useTLS") is not tls:
            p.changes.append(Change("PATCH", "/rest/config/gui", {"useTLS": tls},
                                    f"web UI: useTLS {show(gui.get('useTLS'))} -> {show(tls)}"))
    if cfg.gui_tls == "yes" or (not cfg.gui_tls and api.obj("/rest/config/gui").get("useTLS") is True):
        p.cert = cert_work(api.home)
    return p


# ---------------------------------------------------------------------------
# facts and conditions -- what status and check report

@dataclass
class FolderFacts:
    id: str
    label: str
    path: str
    type: str
    paused: bool
    state: str
    need_bytes: int
    global_bytes: int
    errors: int
    conflicts: int
    remotes: list[tuple[str, float, str]]   # name, completion %, remote state
    changed: str                            # when its state last changed
    files: tuple[int, int]                  # local, global


@dataclass
class Facts:
    host: str
    my_id: str
    version: str
    uptime: int
    conns: dict[str, JObj]
    folders: list[FolderFacts]
    plan: Plan | None                  # None: this host is not in the config yet
    api: str                           # where its REST API answered
    dials: str                         # what Syncthing last dialled, and how it went


def count_conflicts(path: str) -> int:
    n = 0
    for _d, dirs, files in os.walk(path):
        if ".stversions" in dirs:
            dirs.remove(".stversions")
        n += sum(1 for x in files if ".sync-conflict-" in x)
    return n


def conflict_names(path: str) -> list[str]:
    found: list[str] = []
    for d, dirs, files in os.walk(path):
        if ".stversions" in dirs:
            dirs.remove(".stversions")
        found += [os.path.join(d, x) for x in files if ".sync-conflict-" in x]
    return sorted(found)


def gather(cfg: Config, api: Api, host: str) -> Facts:
    PHASE[0] = "reading Syncthing's state"
    st = api.obj("/rest/system/status")
    my_id = jstr(st, "myID")
    version = jstr(api.obj("/rest/system/version"), "version")
    conns = {k: jobj(v, "connection") for k, v in jobj(api.obj("/rest/system/connections").get("connections"),
                                                        "connections").items()}
    folders: list[FolderFacts] = []
    for fo in sorted((jobj(x, "folder") for x in jlist(api.get("/rest/config/folders"))),
                     key=lambda o: jstr(o, "id")):
        fid = jstr(fo, "id")
        ds = api.obj(f"/rest/db/status?folder={fid}")
        errs = len(jlist(api.obj(f"/rest/folder/errors?folder={fid}").get("errors")))
        remotes: list[tuple[str, float, str]] = []
        for x in jlist(fo.get("devices")):
            dev = jstr(jobj(x, "folder device"), "deviceID")
            if dev and dev != my_id:
                c = api.obj(f"/rest/db/completion?folder={fid}&device={dev}")
                remotes.append((cfg.name_of(dev), jnum(c, "completion"), jstr(c, "remoteState")))
        path = jstr(fo, "path")
        folders.append(FolderFacts(
            id=fid, label=jstr(fo, "label"), path=path, type=jstr(fo, "type"), paused=fo.get("paused") is True,
            state=jstr(ds, "state"), need_bytes=jint(ds, "needBytes"), global_bytes=jint(ds, "globalBytes"),
            errors=errs + (1 if jstr(ds, "state") == "error" else 0),
            changed=jstr(ds, "stateChanged"), files=(jint(ds, "localFiles"), jint(ds, "globalFiles")),
            conflicts=count_conflicts(path) if "conflicts" in cfg.conditions and os.path.isdir(path) else 0,
            remotes=remotes))
    plan = make_plan(cfg, api, host, my_id) if cfg.devices.get(host) == my_id else None
    # Syncthing's own record of each address it dialled -- the truth, where the
    # config only says what it SHOULD dial (until --install, the two differ)
    dialled = sorted(jsub(st, "lastDialStatus").items())
    dials = "; ".join(f"{a}: {jstr(jobj(v, 'dial status'), 'error') or 'ok'}" for a, v in dialled) or "no dial yet"
    return Facts(host=host, my_id=my_id, version=version, uptime=jint(st, "uptime"), conns=conns, api=api.base,
                 folders=folders, plan=plan, dials=dials)


@dataclass(frozen=True)
class Condition:
    name: str
    detail: str
    grace: int = 0


def conditions(cfg: Config, f: Facts) -> list[Condition]:
    found: list[Condition] = []
    if f.host != cfg.hub and cfg.hub in cfg.devices:
        c = f.conns.get(cfg.devices[cfg.hub], {})
        if c.get("connected") is not True:
            found.append(Condition("hub-unreachable", f"hub {cfg.hub} not connected [{f.dials}]", cfg.hub_grace))
    for fo in f.folders:
        if fo.paused:
            continue
        if fo.errors:
            found.append(Condition("folder-error", f"{fo.id}: {fo.errors} error(s), state {fo.state} "
                                   f"(`{NAME} diag errors`)"))
        if fo.conflicts:
            found.append(Condition("conflicts", f"{fo.id}: {fo.conflicts} *.sync-conflict-* file(s) "
                                   f"(`{NAME} -V status` names them)"))
        if fo.need_bytes:
            found.append(Condition("out-of-sync", f"{fo.id}: needs {human(fo.need_bytes)} [state {fo.state}]",
                                   cfg.sync_grace))
    if f.plan is None:
        found.append(Condition("drift", f"this host is not in the config: DEVICE_{f.host}={f.my_id}"))
    elif f.plan.todo() or f.plan.blocked:
        items = f.plan.todo() + f.plan.blocked
        found.append(Condition("drift", f"{len(items)} setting(s) not as configured: " + "; ".join(items)))
    return [c for c in found if c.name in cfg.conditions]


def human(n: int) -> str:
    v = float(n)
    for unit in ("B", "kB", "MB", "GB", "TB"):
        if v < 1000 or unit == "TB":
            return f"{v:.0f} {unit}" if unit == "B" else f"{v:.1f} {unit}"
        v /= 1000
    return f"{n} B"


def ago(seconds: int) -> str:
    d, r = divmod(seconds, 86400)
    h, r = divmod(r, 3600)
    return f"{d}d {h}h" if d else f"{h}h {r // 60}m"


def when(iso: str) -> str:
    return iso[:16].replace("T", " ") if iso else "?"


def render(cfg: Config, f: Facts, st: dict[str, dict[str, dict[str, float]]]) -> None:
    role = "hub" if f.host == cfg.hub else f"peer, hub {cfg.hub or '?'}"
    out(f" >>> {f.host} ({role}): Syncthing {f.version}, up {ago(f.uptime)} [id {f.my_id[:7]}]")
    if OUT.vrb:
        out(f"    > config {cfg.path}; Syncthing's {syncthing_home(cfg)}/config.xml; API {f.api}")
    if f.host == cfg.hub:
        for h, dev in sorted(cfg.devices.items()):
            if h == f.host:
                continue
            c = f.conns.get(dev, {})
            out(f"   > {h}: " + (f"connected via {jstr(c, 'address')} since {when(jstr(c, 'startedAt'))} "
                                 f"[{jstr(c, 'type')}]" if c.get("connected") is True else "NOT connected"))
    elif cfg.hub in cfg.devices:
        c = f.conns.get(cfg.devices[cfg.hub], {})
        out(f"    > hub {cfg.hub}: " + (f"connected via {jstr(c, 'address')} since {when(jstr(c, 'startedAt'))} "
                                       f"[{jstr(c, 'type')}]" if c.get("connected") is True else
                                       f"NOT connected [{f.dials}]"))
    for fo in f.folders:
        if fo.paused:
            since = st["disabled"].get(fo.id, {}).get("at")
            at = time.strftime(" since %Y-%m-%d %H:%M", time.localtime(since)) if since else ""
            out(f" >>> folder {fo.id} ({fo.path}): DISABLED here{at} [paused=true] -- `{NAME} enable {fo.id}`")
            continue
        sync = "in sync" if fo.need_bytes == 0 else f"needs {human(fo.need_bytes)}"
        out(f" >>> folder {fo.id} ({fo.path}): {fo.state}, {sync} [{fo.type}; "
            f"{human(fo.global_bytes)}; {fo.errors} error(s); {fo.conflicts} conflict(s)]")
        for name, pct, rs in fo.remotes:
            out(f"    > {name}: {pct:.0f}% [{rs or '?'}]")
        if OUT.vrb:
            out(f"    > files: {fo.files[0]} here, {fo.files[1]} in the cluster; state since {when(fo.changed)}")
        if OUT.vrb and fo.conflicts:
            for x in conflict_names(fo.path):
                out(f"   > {x}")
    for fid, fd in sorted(cfg.folders.items()):
        if f.host in fd.hosts and fid not in {x.id for x in f.folders}:
            out(f" >>> folder {fid} ({fd.path}): NOT set up here -- `{NAME} --install`")
    if f.plan is None:
        out(f" >>> settings: this host is not in the config -- add DEVICE_{f.host}={f.my_id}")
    else:
        todo = f.plan.todo()
        if todo:
            out(f" >>> settings: {len(todo)} change(s) `--install` would make:")
            for w in todo:
                out(f"   > {w}")
        for b in f.plan.blocked:
            out(f" >>> settings: REFUSED -- {b}")
        if not todo and not f.plan.blocked:
            out(" >>> settings: as configured [0 changes]")
    if OUT.vrb and f.plan is not None:
        for n in f.plan.notes:
            out(f"    > {n}")


def report(conds: Sequence[Condition]) -> int:
    for c in conds:
        sys.stderr.write(f"!!! {c.name}: {c.detail}\n")
    if conds:
        out(f" >>> {len(conds)} condition(s): {', '.join(sorted({c.name for c in conds}))}")
        return 1
    out(" >>> healthy [0 conditions]")
    return 0


def cmd_status(cfg: Config) -> int:
    host = this_host()
    st = load_state(cfg)
    try:
        api = connect(cfg)
        facts = gather(cfg, api, host)
    except Down as e:
        out(f" >>> {host}: Syncthing NOT running")
        return report([c for c in [Condition("not-running", e.msg)] if c.name in cfg.conditions])
    render(cfg, facts, st)
    return report(conditions(cfg, facts))


# ---------------------------------------------------------------------------
# check: the conditions, each told at once and -- still there later -- once more

def alert(cmd: str, subject: str, body: str) -> None:
    if not cmd:
        return
    try:
        argv = shlex.split(cmd) + [subject, body]
    except ValueError as e:
        err("00033", f"the alert command '{cmd}': {e}")
    p = run(argv, "the alert", changes=True)
    if p.returncode != 0:
        warn(f"the alert '{cmd}' failed [rc {p.returncode}]: {(p.stderr or p.stdout).strip()[:200]}")


def cmd_check(cfg: Config) -> int:
    host = this_host()
    st = load_state(cfg)
    try:
        conds = conditions(cfg, gather(cfg, connect(cfg), host))
    except Down as e:
        conds = [c for c in [Condition("not-running", e.msg)] if c.name in cfg.conditions]
    PHASE[0] = "telling the conditions"
    now = time.time()
    held: list[Condition] = []
    seen = st["conditions"]
    for c in conds:
        rec = seen.setdefault(c.name, {"first": now})
        if now - rec["first"] < c.grace:
            continue
        held.append(c)
        subject = f"{NAME} {host}: {c.name}"
        if not rec.get("now"):
            alert(cfg.alert_now, subject, c.detail)
            rec["now"] = now
        if not rec.get("later") and now - rec["first"] - c.grace >= cfg.alert_delay:
            alert(cfg.alert_later, subject, f"{c.detail}\n\nsince "
                  + time.strftime("%Y-%m-%d %H:%M", time.localtime(rec["first"] + c.grace)))
            rec["later"] = now
    for name in [n for n in seen if n not in {c.name for c in conds}]:
        if seen[name].get("now"):
            alert(cfg.alert_now, f"{NAME} {host}: {name} cleared", "")
        del seen[name]
    save_state(cfg, st)
    return report(held)


def cmd_test_mail(cfg: Config) -> int:
    if not cfg.alert_later:
        err("00034", "ALERT_LATER is empty -- nothing would be sent; set it in the config "
            f"({cfg.path or 'none found'})")
    body = (f"host {this_host()}, user {this_user()}, {time.strftime('%Y-%m-%d %H:%M %Z')}, "
            f"config {cfg.path}")
    argv = shlex.split(cfg.alert_later) + [f"{NAME} {this_host()}: TEST mail", body]
    p = run(argv, "the test mail")
    if p.returncode != 0:
        err("00035", f"the test mail was NOT sent: {cfg.alert_later} [rc {p.returncode}] "
            f"{(p.stderr or p.stdout).strip()[:200]}")
    out(f" >>> test mail sent through {cfg.alert_later} [rc 0]")
    return 0


# ---------------------------------------------------------------------------
# enable / disable a folder on this host: Syncthing's own `paused` flag

def cmd_pause(cfg: Config, args: list[str], paused: bool) -> int:
    api = connect(cfg)
    have = {jstr(o, "id"): o for o in (jobj(x, "folder") for x in jlist(api.get("/rest/config/folders")))}
    names = args or sorted(have)
    unknown = [n for n in names if n not in have]
    if unknown:
        err("00036", f"no folder {', '.join(unknown)} on this host -- it has: {', '.join(sorted(have)) or 'none'}")
    st = load_state(cfg)
    verb = "disabled" if paused else "enabled"
    for n in names:
        if (have[n].get("paused") is True) == paused:
            out(f" >>> folder {n}: already {verb} here [paused={'true' if paused else 'false'}]")
            continue
        api.write(Change("PATCH", f"/rest/config/folders/{n}", {"paused": paused}, ""))
        if paused:
            st["disabled"][n] = {"at": time.time()}
        else:
            st["disabled"].pop(n, None)
        out(f" >>> folder {n}: {verb} here [paused={'true' if paused else 'false'}]" + (
            f" -- the other hosts go on; `{NAME} enable {n}` syncs it again" if paused else ""))
    save_state(cfg, st)
    return 0


def cmd_web(cfg: Config) -> int:
    api = connect(cfg)
    opener = "open" if ON_MAC else "xdg-open"
    if not shutil.which(opener):
        err("00037", f"no '{opener}' to open {api.base}/ -- open it in a browser yourself")
    p = run([opener, api.base + "/"], "the web UI")
    if p.returncode != 0:
        err("00038", f"{opener} {api.base}/ failed [rc {p.returncode}]")
    out(f" >>> opened {api.base}/")
    return 0


def folder_ids(api: Api, args: list[str]) -> list[str]:
    """The folders named, all of them when none -- an unknown one is an error."""
    have = sorted(jstr(jobj(x, "folder"), "id") for x in jlist(api.get("/rest/config/folders")))
    unknown = [n for n in args if n not in have]
    if unknown:
        err("00039", f"no folder {', '.join(unknown)} on this host -- it has: {', '.join(have) or 'none'}")
    return args or have


def file_names(answer: object) -> list[str]:
    """The `name` of every file object in the lists of a REST answer."""
    found: list[str] = []
    for v in jobj(answer, "file list").values():
        for x in jlist(v):
            if isinstance(x, dict):
                found.append(jstr(cast(JObj, x), "name"))
    return found


def cmd_doctor(cfg: Config, args: list[str]) -> int:
    """Why a folder is out of sync here: read-only, section by section."""
    api = connect(cfg)
    PHASE[0] = "examining the folders"
    my_id = jstr(api.obj("/rest/system/status"), "myID")
    conns = jsub(api.obj("/rest/system/connections"), "connections")
    folders = {jstr(o, "id"): o for o in (jobj(x, "folder") for x in jlist(api.get("/rest/config/folders")))}
    for fid in folder_ids(api, args):
        fo = folders[fid]
        path = jstr(fo, "path")
        remotes = [d for d in (jstr(jobj(x, "folder device"), "deviceID") for x in jlist(fo.get("devices")))
                   if d and d != my_id]
        out(f" >>> folder {fid} ({path}) on {this_host()}")
        out("  >> 1 connection -- nothing comes from a device that is not connected")
        for dev in remotes:
            c = jsub(conns, dev)
            out(f"    > {cfg.name_of(dev)} [{dev[:7]}]: " + (f"connected via {jstr(c, 'address')}"
                                                          if c.get("connected") is True else "NOT connected"))
        ds = api.obj(f"/rest/db/status?folder={fid}")
        out("  >> 2 state -- 'syncing' works on it; 'idle' with files still needed is stuck")
        out(f"    > {jstr(ds, 'state')}; {jint(ds, 'localFiles')} file(s) here of {jint(ds, 'globalFiles')}; "
            f"still needed {jint(ds, 'needFiles')} file(s), {human(jint(ds, 'needBytes'))}")
        out("  >> 3 needed here -- what 'out of sync' refers to")
        need = file_names(api.get(f"/rest/db/need?folder={fid}&page=1&perpage=20"))
        for n in need:
            out(f"   > {n}")
        if not need:
            out("    > none listed" + (f" -- yet {jint(ds, 'needFiles')} counted: a stale index, "
                                       f"`{NAME} rescan {fid}`" if jint(ds, "needFiles") else ""))
        out("  >> 3b what the others still need from here")
        for dev in remotes:
            rn = file_names(api.get(f"/rest/db/remoteneed?folder={fid}&device={dev}&page=1&perpage=5"))
            out(f"    > {cfg.name_of(dev)}: " + ("needs nothing" if not rn else f"still needs {len(rn)}+:"))
            for n in rn:
                out(f"   > {n}")
        out("  >> 4 errors -- usually THE reason: permissions, space, a name the filesystem refuses")
        errs = jlist(api.obj(f"/rest/folder/errors?folder={fid}").get("errors"))
        for x in errs[:15]:
            e = jobj(x, "folder error")
            out(f"   > {jstr(e, 'path')}: {jstr(e, 'error')}")
        if not errs:
            out("    > no per-file errors")
        for x in jlist(api.obj("/rest/system/error").get("errors"))[-5:]:
            out(f"   > (Syncthing) {jstr(jobj(x, 'system error'), 'message')}")
        out("  >> 5 conflicts -- both sides changed a file; nothing is lost")
        names = conflict_names(path) if os.path.isdir(path) else []
        for n in names:
            out(f"   > {n}")
        if not names:
            out("    > none")
        out("  >> 6 ignores -- a file ignored here never arrives here, by design")
        for x in jlist(api.obj(f"/rest/db/ignores?folder={fid}").get("ignore")):
            out(f"   > {x}")
        out("  >> 7 disk space -- a full disk, or Syncthing's reserve, stops writes")
        try:
            du = shutil.disk_usage(path)
            out(f"    > {human(du.free)} free of {human(du.total)}")
        except OSError as e:
            out(f"    > ? [{e.strerror}]")
        mdf = jsub(fo, "minDiskFree")
        out(f"    > Syncthing keeps {jnum(mdf, 'value'):g}{jstr(mdf, 'unit')} free" if jnum(mdf, "value")
            else "    > Syncthing keeps no reserve here [minDiskFree 0]")
        out("  >> 8 clock -- more than a minute of drift between hosts confuses sync")
        out(f"    > here: {time.strftime('%Y-%m-%d %H:%M:%S %z')}")
    out(f" >>> next, least invasive first: `{NAME} rescan`, `{NAME} restart` -- the remedies: `{NAME} --help`")
    return 0


def cmd_rescan(cfg: Config, args: list[str]) -> int:
    api = connect(cfg)
    for fid in folder_ids(api, args):
        api.write(Change("POST", f"/rest/db/scan?folder={fid}", None, ""))
        out(f" >>> folder {fid}: rescan requested")
    return 0


def restart(cfg: Config, api: Api) -> Api:
    """Restart Syncthing through API -- a connection that trusts the certificate it serves NOW --
    and come back connected anew, trusting what it serves AFTER: fix_gui_cert swaps the
    certificate in between, and a connection made after the swap could not send the restart."""
    api.write(Change("POST", "/rest/system/restart", None, ""))
    if OUT.simulate:
        return api
    start = time.time()
    time.sleep(1)
    api = connect(cfg)
    wait_up(api, 60)
    out(f" >>> Syncthing restarted [answering again after {time.time() - start:.0f}s]")
    return api


def cmd_restart(cfg: Config) -> int:
    restart(cfg, connect(cfg))
    return 0


def cmd_export_cert(cfg: Config) -> int:
    """This host's web UI certificate, where a person can trust it (it is public)."""
    src = os.path.join(syncthing_home(cfg), "https-cert.pem")
    try:
        with open(src, "rb") as fh:
            data = fh.read()
    except OSError as e:
        err("00040", f"no web UI certificate at {src} [{e.strerror}] -- has Syncthing run here?")
    desk = os.path.expanduser("~/Desktop")
    dst = os.path.join(desk if os.path.isdir(desk) else os.path.expanduser("~"), f"syncthing-{this_host()}.cer")
    write_file(dst, data, "the web UI certificate of this host")
    out(f" >>> the web UI certificate of {this_host()}: {dst}")
    openssl = shutil.which("openssl")
    for what, opts in (("subject", ["-subject"]), ("expires", ["-enddate"]), ("sha-256", ["-fingerprint", "-sha256"])):
        p = run([openssl, "x509", "-in", src, "-noout", *opts]) if openssl else None
        out(f"    > {what}: {p.stdout.strip().split('=', 1)[-1] if p and p.returncode == 0 else '?'}")
    if ON_MAC:
        out(" >>> trust it AT THIS MAC'S OWN SCREEN, not over ssh: double-click it, Trust -> Always Trust; or")
        out("        security add-trusted-cert -r trustRoot -k ~/Library/Keychains/login.keychain-db "
            + shlex.quote(dst))
    return 0


DIAG: Final = ("plan", "folders", "connections", "conflicts", "errors", "localchanged", "ignores", "config",
               "complete")


def cmd_diag(cfg: Config, args: list[str]) -> int:
    if not args:
        out(f"the blocks: {', '.join(DIAG)}")
        return 0
    block, rest = args[0], args[1:]
    if block == "config":
        out(f"# {cfg.path}")
        for k in sorted(vars(cfg)):
            out(f"{k}={getattr(cfg, k)!r}")
        return 0
    api = connect(cfg)
    folders = [jobj(x, "folder") for x in jlist(api.get("/rest/config/folders"))]
    ids = [f for f in sorted(jstr(o, "id") for o in folders) if not rest or f in rest]
    if block == "complete":
        sys.stdout.write("".join(f"{i}\n" for i in ids))
    elif block == "plan":
        my_id = jstr(api.obj("/rest/system/status"), "myID")
        if cfg.devices.get(this_host()) != my_id:
            out(f"this host is not in the config: DEVICE_{this_host()}={my_id}")
            return 1
        p = make_plan(cfg, api, this_host(), my_id)
        for c in p.changes:
            out(f"{c.why}\n    {c.method} {c.path} {json.dumps(c.body)}")
        if p.cert:
            out(f"{p.cert.why}\n    {'a new certificate, trusted' if p.cert.renew else 'trusted'} by --install")
        for b in p.blocked:
            out(f"REFUSED: {b}")
        for n in p.notes:
            out(f"note: {n}")
    elif block == "connections":
        out(json.dumps(api.get("/rest/system/connections"), indent=1))
    elif block == "folders":
        out(json.dumps([o for o in folders if jstr(o, "id") in ids], indent=1))
    else:
        for fid in ids:
            path = next(jstr(o, "path") for o in folders if jstr(o, "id") == fid)
            if block == "conflicts":
                for x in conflict_names(path):
                    out(x)
            elif block == "errors":
                out(json.dumps(api.get(f"/rest/folder/errors?folder={fid}"), indent=1))
            elif block == "localchanged":
                out(json.dumps(api.get(f"/rest/db/localchanged?folder={fid}"), indent=1))
            elif block == "ignores":
                out(f"# {fid}\n" + "\n".join(x for x in jlist(api.obj(f"/rest/db/ignores?folder={fid}")
                                                                .get("ignore")) if isinstance(x, str)))
            else:
                err("00041", f"diag: no block '{block}' -- {', '.join(DIAG)}")
    return 0


