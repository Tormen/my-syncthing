ALERT_NOW=""              # run at once with <subject> <body>, e.g. a desktop notification
ALERT_LATER=""            # run once if it still holds ALERT_DELAY later, e.g. a mail
ALERT_DELAY=30m

## the devices, one line each, named by host (`--install` on a new host
## prints its line):
##   DEVICE_<host>=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX
## the folders, one line each, the folder id after FOLDER_:
##   FOLDER_<id>="<path> hosts=<hub>,<host>,... [label=<label>]
##       [versioning=staggered:<N>d|trashcan:<N>d|simple:<N>|none]
##       [ignore=<pattern>,<pattern>,...] [perms=ignore|sync] [xattrs=off|on]"
"""

KEYS: Final = ("HUB", "HUB_ADDRESSES", "HUB_LISTEN", "PEER_LISTEN", "PHONE_HOME", "SYNC_USER",
               "SERVICE", "SYNCTHING_HOME", "CHECK_AGENT", "CHECK_INTERVAL", "CONNECT_WAIT", "GUI_TLS", "STATE_DIR",
               "CONDITIONS", "HUB_GRACE", "SYNC_GRACE", "ALERT_NOW", "ALERT_LATER", "ALERT_DELAY")
CONDITION_NAMES: Final = ("not-running", "hub-unreachable", "folder-error", "conflicts",
                          "out-of-sync", "drift")
DEVICE_ID: Final = re.compile(r"[A-Z2-7]{7}(-[A-Z2-7]{7}){7}")
FOLDER_KEYS: Final = ("hosts", "label", "versioning", "ignore", "perms", "xattrs")
SERVICES: Final = ("agent", "daemon", "none")


