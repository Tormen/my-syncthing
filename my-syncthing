        self.ignores: dict[str, list[object]] = {}
        self.state: dict[str, str] = {}
        self.need: dict[str, int] = {}
        self.local: dict[str, int] = {}
        self.conns: dict[str, JObj] = {}
        self.dials: JObj = {}             # lastDialStatus: address -> {when, error}
        self.gui: JObj = {"useTLS": False}
        self.needed: list[str] = []
        self.remote_needed: list[str] = []
        self.file_errors: dict[str, list[object]] = {}
        self.writes: list[tuple[str, str, object]] = []
        self.port = 0
        self.stop: Callable[[], None] = lambda: None

    def start(self) -> None:
        import http.server
        import threading
        stub = self

        class H(http.server.BaseHTTPRequestHandler):
            def log_message(self, format: str, *args: object) -> None:  # noqa: A002 -- the base's name
                pass

            def answer(self) -> None:
                if self.headers.get("X-API-Key") != stub.key:
                    self.send_response(403)
                    self.end_headers()
                    return
                n = int(self.headers.get("Content-Length") or 0)
                body: object = json.loads(self.rfile.read(n)) if n else None
                code, obj = stub.handle(self.command, self.path, body)
                data = json.dumps(obj).encode()
                self.send_response(code)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)

            def do_GET(self) -> None:
                self.answer()

            def do_PUT(self) -> None:
                self.answer()

            def do_PATCH(self) -> None:
                self.answer()

            def do_POST(self) -> None:
                self.answer()

        srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), H)
        self.port = srv.server_address[1]
        threading.Thread(target=srv.serve_forever, daemon=True).start()

        def stop() -> None:
            srv.shutdown()
            srv.server_close()
        self.stop = stop

    def folder(self, fid: str) -> JObj:
        return next(f for f in self.folders if f.get("id") == fid)

    def handle(self, method: str, raw: str, body: object) -> tuple[int, object]:
        import urllib.parse
        u = urllib.parse.urlsplit(raw)
        q = dict(urllib.parse.parse_qsl(u.query))
        p = u.path
        fid = q.get("folder", "")
        if method != "GET":
            self.writes.append((method, raw, body))
        if (method, p) == ("GET", "/rest/system/ping"):
            return 200, {"ping": "pong"}
        if (method, p) == ("GET", "/rest/system/status"):
            return 200, {"myID": self.my_id, "uptime": 3700, "lastDialStatus": self.dials}
        if (method, p) == ("GET", "/rest/system/version"):
            return 200, {"version": "v2.1.5"}
        if (method, p) == ("GET", "/rest/system/connections"):
            return 200, {"connections": self.conns, "total": {}}
        if p == "/rest/config/options":
            if method == "PATCH":
                self.options.update(jobj(body, "test body"))
            return 200, self.options
        if p == "/rest/config/devices":
            return 200, self.devices
        if p.startswith("/rest/config/devices/"):
            dev = p.rsplit("/", 1)[1]
            have = [d for d in self.devices if d.get("deviceID") == dev]
            if method == "PUT":
                self.devices = [d for d in self.devices if d.get("deviceID") != dev] + [jobj(body, "test body")]
            elif method == "PATCH" and have:
                have[0].update(jobj(body, "test body"))
            return 200, {}
        if p == "/rest/config/folders":
            return 200, self.folders
        if p.startswith("/rest/config/folders/"):
            fid = p.rsplit("/", 1)[1]
            if method == "PUT":
                self.folders = [f for f in self.folders if f.get("id") != fid] + [jobj(body, "test body")]
            elif method == "PATCH":
                self.folder(fid).update(jobj(body, "test body"))
            return 200, {}
        if p == "/rest/db/ignores":
            if method == "POST":
                self.ignores[fid] = jlist(jobj(body, "test body").get("ignore"))
            return 200, {"ignore": self.ignores.get(fid)}
        if p == "/rest/db/status":
            return 200, {"state": self.state.get(fid, "idle"), "needBytes": self.need.get(fid, 0),
                         "globalBytes": 4096}
        if p == "/rest/db/completion":
            return 200, {"completion": 100, "remoteState": "valid"}
        if p == "/rest/folder/errors":
            return 200, {"folder": fid, "errors": self.file_errors.get(fid, [])}
        if p == "/rest/config/gui":
            if method == "PATCH":
                self.gui.update(jobj(body, "test body"))
            return 200, self.gui
        if p == "/rest/db/need":
            return 200, {"progress": [], "queued": [], "rest": [{"name": n} for n in self.needed], "page": 1}
        if p == "/rest/db/remoteneed":
            return 200, {"files": [{"name": n} for n in self.remote_needed], "page": 1}
        if p == "/rest/system/error":
            return 200, {"errors": None}
        if (method, p) in (("POST", "/rest/db/scan"), ("POST", "/rest/system/restart")):
            return 200, {}
        if p == "/rest/db/localchanged":
            return 200, {"files": [{"name": f"x{i}"} for i in range(self.local.get(fid, 0))], "page": 1}
        return 404, {"error": f"the stub has no {method} {p}"}


# Loads this file as a module and calls main() with the check's log root: the
# seam the tests use. "boom" plants an exception nothing expects.
LOADER: Final = """\
import sys, importlib.util, importlib.machinery
ld = importlib.machinery.SourceFileLoader("my_syncthing", sys.argv[1])
spec = importlib.util.spec_from_loader("my_syncthing", ld)
assert spec is not None
m = importlib.util.module_from_spec(spec)
ld.exec_module(m)
if sys.argv[3] == "boom":
    def boom(cfg):
        raise ZeroDivisionError("planted by the test")
    m.cmd_status = boom
sys.exit(m.main(sys.argv[4:], log_root=sys.argv[2]))
"""


class T:
    """What a test gets: its own directory, a stub Syncthing, the verdict helpers."""

    def __init__(self) -> None:
        self.root = ""
        self.passed = 0
        self.failed = 0
        self.host = this_host()
        self.stub = Stub(ID_ME)

    def ok(self, what: str) -> None:
        sys.stdout.write(f"  ok   {what}\n")
        self.passed += 1

    def bad(self, what: str) -> None:
        sys.stdout.write(f"  FAIL {what}\n")
        self.failed += 1

    def is_(self, what: str, got: object, want: object) -> None:
        if got == want:
            self.ok(what)
        else:
            self.bad(f"{what} (want {want!r}, got {got!r})")

    def has(self, what: str, text: str, part: str) -> None:
        if part in text:
            self.ok(what)
        else:
            self.bad(f"{what} (no {part!r} in {text!r})")

    def p(self, *rel: str) -> str:
        return os.path.join(self.root, *rel)

    def setup(self, root: str) -> None:
        self.root = root
        for d in ("home", "st", "state", "log", "bin", "data"):
            os.makedirs(self.p(d))
        self.stub = Stub(ID_ME)
        self.stub.start()
        self.gui(self.stub.port)
        with open(self.p("bin", "alert"), "w") as fh:
            fh.write(f"#!/bin/dash\nprintf '%s|%s|%s\\n' \"$1\" \"$2\" \"$(printf %s \"$3\" | tr '\\n' ' ')\" "
                     f">> {shlex.quote(self.p('alerts'))}\n")
        os.chmod(self.p("bin", "alert"), 0o755)
        # macOS' `security`: records each call; a certificate counts as trusted once added
        with open(self.p("bin", "security"), "w") as fh:
            fh.write(f"#!/bin/dash\nprintf '%s\\n' \"$*\" >> {shlex.quote(self.p('security.calls'))}\n"
                     f"case $1 in verify-cert) [ -e {shlex.quote(self.p('trusted'))} ] ;; "
                     f"add-trusted-cert) if [ -e {shlex.quote(self.p('deny'))} ]; then echo 'The authorization "
                     f"was denied since no user interaction was possible.' >&2; exit 1; fi; "
                     f"touch {shlex.quote(self.p('trusted'))} ;; esac\n")
        os.chmod(self.p("bin", "security"), 0o755)
        self.conf()

    def gui(self, port: int) -> None:
        with open(self.p("st", "config.xml"), "w") as fh:
            fh.write(f'<configuration><gui tls="false"><address>127.0.0.1:{port}</address>'
                     f'<apikey>{self.stub.key}</apikey></gui></configuration>\n')

    def conf(self, **over: str) -> None:
        """The test config: a peer of hub 'hubx' with one folder; KEY='' drops a key."""
        c = {"HUB": "hubx", "HUB_ADDRESSES": "tcp://192.0.2.1:22000", "SERVICE": "none", "CHECK_AGENT": "no",
             "SYNCTHING_HOME": self.p("st"), "STATE_DIR": self.p("state"), "HUB_GRACE": "0s", "SYNC_GRACE": "0s",
             "CONNECT_WAIT": "0s",
             "ALERT_NOW": f"{self.p('bin', 'alert')} now", "ALERT_LATER": f"{self.p('bin', 'alert')} later",
             f"DEVICE_{self.host}": ID_ME, "DEVICE_hubx": ID_HUB,
             "FOLDER_data": f"{self.p('data')} hosts=hubx,{self.host} versioning=staggered:365d "
                            f"ignore=(?d).DS_Store,.git,/2/learn"}
        c.update(over)
        with open(self.p("conf"), "w") as fh:
            fh.write("".join(f"{k}={shlex.quote(v)}\n" for k, v in c.items() if v != "" or k == "ALERT_LATER"))

    def proc(self, args: Sequence[str], boom: bool = False, script: str = "") -> subprocess.Popen[bytes]:
        env = {"PATH": self.p("bin") + os.pathsep + os.environ.get("PATH", ""), "HOME": self.p("home"),
               "USER": this_user(), "LINKS": self.p("links"), CONFIG_ENV: self.p("conf")}
        return subprocess.Popen(
            [sys.executable, "-I", "-S", "-B", "-c", LOADER, script or os.path.realpath(__file__), self.p("log"),
             "boom" if boom else "-", *args],
            cwd=self.root, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, stdin=subprocess.DEVNULL)

    def run(self, *args: str, boom: bool = False, script: str = "") -> tuple[int, str, str]:
        p = self.proc(args, boom, script)
        o, e = p.communicate()
        return p.returncode, o.decode(errors="replace"), e.decode(errors="replace")

    def alerts(self) -> list[str]:
        try:
            with open(self.p("alerts")) as fh:
                return fh.read().splitlines()
        except FileNotFoundError:
            return []

    def security_calls(self) -> str:
        try:
            with open(self.p("security.calls")) as fh:
                return fh.read()
        except FileNotFoundError:
            return ""

    def hub_up(self, up: bool = True) -> None:
        self.stub.conns = {ID_HUB: {"connected": True, "address": "192.0.2.1:22000",
                                    "startedAt": "2026-10-26T08:29:19+01:00", "type": "tcp-client"}} if up else {}


