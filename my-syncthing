def t_launchd_reload(t: T) -> None:
    # launchd lets go of a booted-out service a moment AFTER bootout returns; a
    # bootstrap in that moment fails with rc 5 (ada, 2026-10-28: the service was
    # left unloaded, Syncthing down)
    loaded = shlex.quote(t.p("loaded"))
    open(t.p("loaded"), "w").close()
    with open(t.p("bin", "launchctl"), "w") as fh:
        fh.write(f"#!/bin/dash\ncase $1 in\n  print) [ -e {loaded} ] ;;\n"
                 f"  bootout) ( sleep 1; rm -f {loaded} ) >/dev/null 2>&1 & ;;\n"
                 f"  bootstrap) if [ -e {loaded} ]; then echo 'Bootstrap failed: 5: Input/output error' >&2; "
                 f"exit 5; fi; touch {loaded} ;;\nesac\n")
    os.chmod(t.p("bin", "launchctl"), 0o755)
    path = os.environ["PATH"]
    os.environ["PATH"] = t.p("bin") + os.pathsep + path
    try:
        launchd_load("system", "test.label", t.p("x.plist"), True)
        t.ok("a changed service: booted out, then loaded again once launchd has let go")
    except Err as e:
        t.bad(f"the reload failed: ERROR {e.code}: {e.msg}")
    finally:
        os.environ["PATH"] = path
    time.sleep(1.5)                      # past the stub's delayed let-go of the old one
    t.is_("...and it is loaded", os.path.exists(t.p("loaded")), True)


def t_api_pinned(t: T) -> None:
    # the web UI's certificate is trusted by being EXACTLY the one in https-cert.pem -- never
    # as a trust anchor: Apple's python (LibreSSL 2.8.3) refuses Syncthing's own certificate
    # that way ("unable to get local issuer certificate", horse 2026-10-28 22:32)
    import threading
    def cert(name: str, *extra: str) -> tuple[str, str]:
        c, k = t.p(f"{name}.pem"), t.p(f"{name}.key")
        p = subprocess.run(["openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:P-256",
                            "-pkeyopt", "ec_param_enc:named_curve", "-nodes", "-subj", "/CN=horse",
                            "-addext", "keyUsage=critical,digitalSignature", "-addext",
                            "basicConstraints=critical,CA:FALSE", *extra, "-keyout", k, "-out", c],
                           capture_output=True, text=True)
        return (c, k) if p.returncode == 0 else ("", p.stderr)
    old, why = cert("old", "-not_before", "20200101000000Z", "-not_after", "20200102000000Z")
    if not old:
        t.ok(f"this openssl cannot make an expired certificate -- nothing to check [{why.strip()[:60]}]")
        return
    other, _ = cert("other", "-days", "30")
    srv = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    srv.load_cert_chain(old, t.p("old.key"))
    ls = socket.socket()
    ls.bind(("127.0.0.1", 0))
    ls.listen(4)
    port = ls.getsockname()[1]
    def serve() -> None:
        while True:
            try:
                c, _ = ls.accept()
            except OSError:
                return
            try:
                with srv.wrap_socket(c, server_side=True) as sc:
                    sc.recv(4096)
                    sc.sendall(b'HTTP/1.1 200 OK\r\nContent-Length: 15\r\nConnection: close\r\n\r\n{"ping":"pong"}')
            except (OSError, ssl.SSLError):
                pass
    threading.Thread(target=serve, daemon=True).start()
    home = t.p("sthome")
    os.makedirs(home, exist_ok=True)
    try:
        shutil.copy(old, os.path.join(home, "https-cert.pem"))
        ctx, pin = tls_pin(home)
        api = Api(base=f"https://127.0.0.1:{port}", key="k", ctx=ctx, home=home, pin=pin)
        t.is_("the certificate served IS the one in https-cert.pem: trusted -- even one no chain check "
              "would accept (expired)", api.get("/rest/system/ping"), {"ping": "pong"})
        shutil.copy(other, os.path.join(home, "https-cert.pem"))
        ctx, pin = tls_pin(home)
        api = Api(base=f"https://127.0.0.1:{port}", key="k", ctx=ctx, home=home, pin=pin)
        try:
            api.get("/rest/system/ping")
            t.bad("another certificate than the file's was trusted")
        except Down as e:
            t.has("...another certificate than the file's: refused, saying so", e.msg,
                  "not the certificate in https-cert.pem")
    finally:
        ls.close()


def t_gui_cert_named_curve(t: T) -> None:
    # macOS's own openssl (LibreSSL) writes an EC key with EXPLICIT curve parameters unless told
    # otherwise; Syncthing (Go) refuses that key ("x509: invalid ECDSA parameters") and replaces the
    # certificate with one of its own -- horse, 2026-10-28 21:03, where --install ran on that openssl
    libre = "/usr/bin/openssl"
    if not os.path.exists(libre) or "LibreSSL" not in subprocess.run([libre, "version"], capture_output=True,
                                                                    text=True).stdout:
        t.ok("no LibreSSL openssl here -- nothing to check")
